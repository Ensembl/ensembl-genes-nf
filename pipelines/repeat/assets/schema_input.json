{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/demultiplex/master/assets/schema_input.json",
    "title": "nf-core/demultiplex pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "species_name": {
                "type": "string",
                "description": "Species name ",
                "pattern": "^\\S+$",
                "errorMessage": "Please provide the species name",
                "meta": ["species_name"]
            },
            "gca": {
                "type": "string",
                "description": "Genome assembly accession",
                "pattern": "^GCA_\\d{9}\\.\\d$",
                "errorMessage": "GCA must be in the format GCA_000000000.0",
                "meta": ["gca"]
            },
            
            "genome_file": {
                    "type": "string",
                    "pattern": "^\\S+$",
                    "errorMessage": "Genome file path must be provided and cannot contain or have trailing spaces",
                    "meta": ["genome_file"]
                }

        }
    }
}