/*
========================================================================================
    RIBOSEQ PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Plugins
plugins {
    id 'nf-schema@2.2.0'
}

// Pipeline-specific parameters
params {
    // Input/Output
    sample_sheet = null

    // Reference files
    star_index = null
    gtf = null
    fasta = null
    ribometric_annotation = null  // Optional: for RiboMetric QC
    chrom_sizes_file = null
    adapter_list = "${projectDir}/resources/adapter_list.tsv"

    // Data fetching
    fetch = true
    force_fetch = false
    collapsed_read_path = null
    use_architecture_detection = true

    // Alignment parameters
    mismatches = 3
    alignment_type = 'EndToEnd'  // or 'Local'
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0
    trim_front = 0

    // RiboWaltz parameters
    ribowaltz_exclude_start = 0
    ribowaltz_exclude_stop = 0

    // Unique reads tracking (optional, disabled by default)
    enable_unique_reads_tracking = false
    unique_reads_mode = 'per_run'  // or 'progressive'
    unique_reads_previous_index = null
}

// Process-specific configuration
process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    // FASTQ_DL - limit concurrent downloads to avoid overwhelming SRA
    withName: 'DATA_ACQUISITION:FASTQ_DL' {
        maxForks = 30
    }

    // STAR alignment - limit concurrent jobs due to high memory usage
    withName: 'ALIGNMENT:STAR_ALIGN' {
        maxForks = 50
    }

    // BAM to BED conversion - generate stranded bedgraphs
    withName: 'POST_PROCESSING:BAM_TO_BED' {
        ext.args = '--stranded'
    }

    // RiboMetric - allow retries on failure, increase time
    withName: 'ANALYSIS:RIBOMETRIC' {
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
        maxRetries = 1
        time = '16.h'
    }

    // RiboWaltz - allow retries with increasing memory
    withName: 'ANALYSIS:RIBOWALTZ' {
        errorStrategy = { task.exitStatus in [137,140] ? 'retry' : 'ignore' }
        maxRetries = 6
        time = '8.h'
        memory = { 16.GB * task.attempt }
    }
}

// Execution profiles
profiles {
    // Default: SLURM with Singularity (for HPC cluster execution)
    slurm {
        process {
            executor = 'slurm'
        }
        singularity {
            enabled = true
            autoMounts = true
        }
    }

    // Local execution with Singularity (for testing/development)
    local {
        process {
            executor = 'local'
            // Reduce parallelism for local execution
            maxForks = 2
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = './singularity_cache'
        }
    }

    // Conda-based execution (alternative to containers)
    conda {
        conda {
            enabled = true
            useMicromamba = true
            cacheDir = './conda_cache'
        }
        singularity.enabled = false
    }

    // Docker execution (for non-HPC environments)
    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        singularity.enabled = false
    }
}
