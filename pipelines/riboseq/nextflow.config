/*
========================================================================================
    RIBOSEQ PIPELINE CONFIGURATION
========================================================================================
*/

// Plugins
plugins {
    id 'nf-schema@2.2.0'
}

// Pipeline-specific parameters
params {
    // Input/Output
    sample_sheet = null
    outdir = './results'

    // Reference files
    star_index = null
    gtf = null
    ribometric_annotation = null
    chrom_sizes_file = null
    adapter_list = "${projectDir}/resources/adapter_list.tsv"

    // Data fetching
    fetch = true
    force_fetch = false
    collapsed_read_path = null
    use_architecture_detection = true

    // Alignment parameters
    mismatches = 3
    alignment_type = 'EndToEnd'  // or 'Local'
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0
    trim_front = 0
    save_star_transcriptome_bam = true

    // Process-specific settings can be overridden via command line or config
}

// Process-specific configuration
process {
    // FASTQ_DL specific settings
    withName: 'FASTQ_DL' {
        maxForks = 3  // Limit concurrent downloads
    }

    // STAR alignment settings
    withName: 'STAR_ALIGN' {
        maxForks = 5  // Limit concurrent alignments
    }

    // BAM to BED conversion
    withName: 'BAM_TO_BED' {
        ext.args = '--stranded'  // Generate stranded bedgraphs
    }
}