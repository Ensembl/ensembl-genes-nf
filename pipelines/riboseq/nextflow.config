/*
========================================================================================
    RIBOSEQ PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Nextflow 26 uses the strict DSL2 parser by default. Keep this explicit so
// compatibility is tested consistently on older supported runtimes as well.
nextflow.enable.strict = true

// Plugins
plugins {
    id 'nf-schema@2.2.0'
}

// Pipeline-specific parameters
params {
    // Input/Output
    sample_sheet = null
    sample_sheet_sep = null       // Optional delimiter override; inferred from .tsv/.csv when unset

    // Reference files
    star_index = null
    gtf = null
    fasta = null
    ribometric_annotation = null  // Optional: for RiboMetric QC
    chrom_sizes_file = null
    adapter_list = "${projectDir}/resources/adapter_list.tsv"
    rrna_index = null  // Optional: path to bowtie1 index directory or any index file (e.g., /path/to/rRNA_index)

    // ==========================================
    // ORGANISM SETUP PARAMETERS
    // ==========================================
    // Run modes
    run_organism_setup = false       // Standalone mode: only build reference files
    auto_build_indices = false       // Integrated mode: auto-build if indices missing

    // Organism info
    organism = null                  // e.g., "homo_sapiens", "saccharomyces_cerevisiae"
    ensembl_version = null           // e.g., 112 (for gget download)

    // Download settings
    download_method = 'gget'         // 'gget' (Ensembl) or 'url' (custom URLs)
    gget_which = ['dna', 'gtf']      // File types to download with gget

    // Custom URL download (only used if download_method == 'url')
    genome_fasta_url = null          // URL to genome FASTA file
    genome_gtf_url = null            // URL to GTF annotation file

    // rRNA settings
    rrna_source = 'gtf'              // 'gtf' (extract from annotation) or 'silva' (download from SILVA)
    silva_url = null                 // SILVA rRNA database URL (only if rrna_source == 'silva')

    // ==========================================
    // TRACKHUB GENERATION PARAMETERS
    // ==========================================
    generate_trackhub = false        // Enable track hub generation
    hub_name = 'riboseq_hub'         // Track hub name
    genome_assembly = null           // UCSC genome assembly (e.g., 'hg38', 'mm39', 'sacCer3')
    hub_email = 'noreply@example.com' // Contact email for hub
    sample_regex = null              // Optional: regex to extract sample ID from filename
    annotation_regex = null          // Optional: regex to extract annotation type from filename

    // ==========================================
    // DATA FETCHING PARAMETERS
    // ==========================================
    fetch = true
    force_fetch = false
    collapsed_read_path = null

    // ==========================================
    // RPF EXTRACTION PARAMETERS
    // ==========================================
    // Method selection: 'getrpf' (architecture detection) or 'traditional' (fastp + optional rRNA filter)
    rpf_extraction_method = 'getrpf'

    // getRPF-specific parameters (when rpf_extraction_method = 'getrpf')
    getrpf_max_reads = 5000              // Max reads for architecture detection sampling
    getrpf_command = 'extract'           // Command: 'extract', 'extract-rpf', 'decide-trim'
    getrpf_preserve_umi = false          // Preserve UMI in output

    // Traditional method parameters (when rpf_extraction_method = 'traditional')
    // Adapter detection method: 'auto' (fastp auto), 'fastqc_tophit', 'explicit', 'fasta'
    adapter_detection_method = 'auto'
    fastp_adapter_sequence = null        // Explicit adapter sequence (when method = 'explicit')
    fastp_adapter_fasta = null           // FASTA file with adapter sequences (when method = 'fasta')
    min_read_length = 20                 // Minimum read length after trimming (fastp)
    max_read_length = 0                  // Maximum read length (0 = no limit)

    // ==========================================
    // rRNA FILTERING PARAMETERS
    // ==========================================
    // Enable rRNA filtering (requires rrna_index for bowtie method)
    run_rrna_filter = false              // Explicitly enable rRNA filtering step
    rrna_filter_method = 'bowtie'        // 'bowtie' or 'ribodetector'

    // Bowtie-specific rRNA filtering parameters
    bowtie_rrna_mismatches = 2           // Bowtie -v parameter for rRNA alignment
    bowtie_rrna_k = 1                    // Bowtie -k parameter (report first k alignments)

    // RiboDetector-specific parameters (ML-based, no reference required)
    ribodetector_chunk_size = 256        // Sequences per batch
    ribodetector_len = 100               // Read length threshold

    // ==========================================
    // ALIGNMENT PARAMETERS (STAR)
    // ==========================================
    mismatches = 3                       // --outFilterMismatchNmax
    alignment_type = 'EndToEnd'          // 'EndToEnd' or 'Local' (--alignEndsType)
    allow_introns = true                 // Enable spliced alignment
    max_multimappers = 10                // --outFilterMultimapNmax
    min_mapq = 0                         // Minimum MAPQ for filtering
    trim_front = 0                       // --clip3pNbases (trim from 3' end)

    // Soft-clipping parameters (primarily for Local alignment mode)
    clip_5p_nbases = null                // Trim N bases from 5' end (--clip5pNbases)
    clip_3p_nbases = null                // Trim N bases from 3' end (--clip3pNbases)
    align_soft_clip_at_ref_ends = null   // Allow soft-clip at ref ends: 'Yes' or 'No'

    // ==========================================
    // READ LENGTH FILTERING (post-alignment)
    // ==========================================
    filter_by_length = false             // Enable read length filtering
    rpf_length_min = 26                  // Minimum RPF length to keep
    rpf_length_max = 34                  // Maximum RPF length to keep

    // ==========================================
    // RIBOMETRIC PARAMETERS
    // ==========================================
    ribometric_offset_method = 'tripsviz'   // Offset calculation: 'tripsviz', 'changepoint', 'ribowaltz'
    ribometric_offset_target = 'a_site'     // Site represented by calculated offsets: 'a_site' or 'p_site'
    ribometric_sample_size = 10000000       // Number of reads to sample (-S)
    ribometric_offset_global = null         // Fixed global offset (e.g., 12 or 15)
    ribometric_use_ribowaltz_offsets = false // Pass RiboWaltz offsets to RiboMetric

    // ==========================================
    // CHOROS CODON-LEVEL BIAS CORRECTION (PILOT)
    // ==========================================
    run_choros = false
    transcriptome_fasta = null
    choros_container = null
    choros_num_genes = 250
    choros_min_coverage = 5
    choros_min_nonzero = 100

    // ==========================================
    // RIBOWALTZ PARAMETERS
    // ==========================================
    ribowaltz_exclude_start = 0          // Exclude nt from start codon in CDS coverage
    ribowaltz_exclude_stop = 0           // Exclude nt from stop codon in CDS coverage
    ribowaltz_flanking = 6               // Flanking nt for P-site calculation
    ribowaltz_extremity = 'auto'         // P-site extremity: 'auto', '5end', '3end'
    ribowaltz_confidence_level = 99      // Confidence level for plots (%)
    ribowaltz_utr5_length = 25           // UTR5 length for metaprofile
    ribowaltz_cds_length = 40            // CDS length for metaprofile
    ribowaltz_utr3_length = 25           // UTR3 length for metaprofile

    // ==========================================
    // OUTPUT NORMALIZATION
    // ==========================================
    normalize_coverage = false           // Enable coverage normalization
    normalization_method = 'cpm'         // 'cpm' (counts per million) or 'rpkm'

    // ==========================================
    // UNIQUE READS TRACKING (optional, per-sample mode only)
    // ==========================================
    enable_unique_reads_tracking = false
    unique_reads_mode = 'per_run'        // 'per_run' or 'progressive'
    unique_reads_previous_index = null

    // ==========================================
    // MATRIX MODE (scalable unique reads pipeline)
    // ==========================================
    // When enabled, builds a global unique reads matrix instead of
    // per-sample alignments. Designed for 1000+ samples.
    //
    // Pipeline flow in matrix mode:
    // 1. Per-sample: collapsed FASTA -> sorted TSV
    // 2. Per-study: TSVs -> study matrix (sparse, checkpointed)
    // 3. Global: study matrices -> global sparse count store + unique FASTA
    // 4. Optional alignment: unique FASTA -> BAM (one alignment per unique read)
    //
    // Downstream (future): BAM + matrix -> locus queries -> periodicity -> translon annotation
    run_matrix_mode = false
    matrix_align_unique_reads = true      // Align global unique-read FASTA after matrix merge
    matrix_format = 'sparse-parquet'      // Global matrix output: 'sparse-parquet' or 'dense'
    matrix_chunk_size = 10000            // Dense/Zarr chunk size (rows per chunk)
    matrix_sparse_shard_rows = 5000000    // Nonzero rows per sparse Parquet part
    matrix_sparse_read_bucket_size = 100000 // Global read IDs per sparse Parquet read_bucket partition
    matrix_append_to = null              // Existing sparse global output/manifest to append as a new generation
    matrix_tsv_chunk_size = 500000       // Per-sample FASTA->TSV sort chunk size
    matrix_metadata_shard_rows = 1000000   // Rows per global metadata/read lookup parquet shard
    matrix_use_partitioning = false      // Split matrix build by sequence prefix for very large studies
    matrix_partition_prefix_length = 4   // 4 gives 256 A/C/G/T prefix partitions plus NNNN catch-all
    matrix_partition_stride = 1000000000 // Reserved read_id namespace per partition
    matrix_partition_sparse_read_bucket_size = 50000000 // Larger buckets reduce per-partition file counts
    matrix_partition_qc_enabled = true
    matrix_partition_qc_action = 'record'  // 'record' filters failed samples without stopping the run; also supports 'fail' or 'warn'
    matrix_partition_qc_min_total_records = 1
    matrix_partition_qc_min_total_counts = 1
    matrix_partition_qc_max_n_unique_fraction = 0.05
    matrix_partition_qc_max_n_count_fraction = 0.05

    // ==========================================
    // QC METRICS DATABASE & GATE
    // ==========================================
    metrics_db = null                 // Path for DuckDB metrics store (default: "${params.outdir}/pipeline_info/qc.duckdb")
    qc_rules = "${projectDir}/resources/qc_rules.default.yaml"
    qc_rule_set_name = 'default'
    apply_gate_for = 'translon,trackhub'  // 'none' to disable gating effects
    emit_both_offsets = false
    eq_delta = null
    score_tag = 'AS'

    // ==========================================
    // TRANSLONSCORER INTEGRATION
    // ==========================================
    run_translonscorer = false                     // Enable TranslonScorer
    translonscorer_bam_type = 'unique_no_junction' // Which filtered BAM-derived bigwig to use
    translonscorer_scoring_method = 'modern'       // 'modern' or 'classic'
    translonscorer_plot_range = 30
    translonscorer_pip_spec = null                 // Override pip spec; prefer container in prod
    translonscorer_container = null

}

// Process-specific configuration
process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    // FASTQ_DL - limit concurrent downloads to avoid overwhelming SRA
    withName: 'DATA_ACQUISITION:FASTQ_DL' {
        maxForks = 30
    }

    // STAR alignment - limit concurrent jobs due to high memory usage
    withName: 'ALIGNMENT:STAR_ALIGN' {
        maxForks = 50
    }

    // BAM to BED conversion - generate stranded bedgraphs
    withName: 'POST_PROCESSING:BAM_TO_BED|PSITE_BIGWIG:BAM_TO_BED' {
        ext.args = '--stranded'
    }

    // RiboMetric - retry once, then skip samples with no usable reads/metrics
    withName: 'ANALYSIS:RIBOMETRIC' {
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
        maxRetries = 1
        time = '16.h'
    }

    // RiboWaltz - explicit or fallback offset calculation only
    withName: 'ANALYSIS:RIBOWALTZ|PSITE_BIGWIG:RIBOWALTZ' {
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 6
        time = '16.h'
        memory = { 80.GB * task.attempt }
    }

    withName: 'CHOROS' {
        errorStrategy = 'finish'
        time = '24.h'
    }

}

// Execution profiles
profiles {
    // Default: SLURM with Singularity (for HPC cluster execution)
    slurm {
        process {
            executor = 'slurm'
        }
        singularity {
            enabled = true
            autoMounts = false
        }
    }

    // Local execution for stub testing (no containers, minimal resources)
    local {
        process {
            executor = 'local'
            // Reduce parallelism for local execution
            maxForks = 2
        }
        singularity {
            enabled = false
        }
    }

    // Conda-based execution (alternative to containers)
    conda {
        conda {
            enabled = true
            useMicromamba = true
            cacheDir = './conda_cache'
        }
        singularity.enabled = false
    }

    // Docker execution (for non-HPC environments)
    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        singularity.enabled = false
    }
}
