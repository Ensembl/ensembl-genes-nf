// Clean Ensembl Beta RiboSeq config for Oryza sativa
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: Japonica/Nipponbare rice reference group
// Beta species directory: Oryza_sativa_Japonica_Group
// Assembly: GCA_001433935.1
// Annotation provider: community
// Geneset date: 2019_06

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/oryza_sativa_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/oryza_sativa"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Oryza sativa"
    ensembl_version = "beta_2019_06_GCA_001433935.1_community"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Oryza_sativa_Japonica_Group/GCA_001433935.1/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Oryza_sativa_Japonica_Group/GCA_001433935.1/community/geneset/2019_06/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
