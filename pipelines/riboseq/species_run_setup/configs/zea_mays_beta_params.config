// Clean Ensembl Beta RiboSeq config for Zea mays
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: maize reference exposed by Ensembl Beta
// Beta species directory: Zea_mays
// Assembly: GCA_902167145.1
// Annotation provider: community
// Geneset date: 2019_12

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/zea_mays_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/zea_mays"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Zea mays"
    ensembl_version = "beta_2019_12_GCA_902167145.1_community"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Zea_mays/GCA_902167145.1/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Zea_mays/GCA_902167145.1/community/geneset/2019_12/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
