// Clean Ensembl Beta RiboSeq config for Caenorhabditis elegans
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: WormBase C. elegans reference
// Beta species directory: Caenorhabditis_elegans
// Assembly: GCA_000002985.3
// Annotation provider: wormbase
// Geneset date: 2014_10

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/caenorhabditis_elegans_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/caenorhabditis_elegans"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Caenorhabditis elegans"
    ensembl_version = "beta_2014_10_GCA_000002985.3_wormbase"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Caenorhabditis_elegans/GCA_000002985.3/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Caenorhabditis_elegans/GCA_000002985.3/wormbase/geneset/2014_10/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
