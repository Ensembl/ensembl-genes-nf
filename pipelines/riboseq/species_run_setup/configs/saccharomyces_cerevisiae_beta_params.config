// Clean Ensembl Beta RiboSeq config for Saccharomyces cerevisiae
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: S288C reference strain
// Beta species directory: Saccharomyces_cerevisiae_S288c
// Assembly: GCA_000146045.2
// Annotation provider: community
// Geneset date: 2018_10

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/saccharomyces_cerevisiae_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/saccharomyces_cerevisiae"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Saccharomyces cerevisiae"
    ensembl_version = "beta_2018_10_GCA_000146045.2_community"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Saccharomyces_cerevisiae_S288c/GCA_000146045.2/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Saccharomyces_cerevisiae_S288c/GCA_000146045.2/community/geneset/2018_10/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
