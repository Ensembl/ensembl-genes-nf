// Clean Ensembl Beta RiboSeq config for Gallus gallus
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: chicken Beta reference
// Beta species directory: Gallus_gallus
// Assembly: GCA_027557775.1
// Annotation provider: ensembl
// Geneset date: 2023_06

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/gallus_gallus_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/gallus_gallus"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Gallus gallus"
    ensembl_version = "beta_2023_06_GCA_027557775.1_ensembl"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Gallus_gallus/GCA_027557775.1/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Gallus_gallus/GCA_027557775.1/ensembl/geneset/2023_06/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
