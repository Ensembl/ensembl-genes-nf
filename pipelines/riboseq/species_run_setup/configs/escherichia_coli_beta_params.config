// Clean Ensembl Beta RiboSeq config for Escherichia coli
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: K-12 MG1655 reference strain
// Beta species directory: Escherichia_coli_str_k_12_substr_mg1655
// Assembly: GCA_000005845.2
// Annotation provider: community
// Geneset date: 2018_09

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/escherichia_coli_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/escherichia_coli"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Escherichia coli"
    ensembl_version = "beta_2018_09_GCA_000005845.2_community"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Escherichia_coli_str_k_12_substr_mg1655/GCA_000005845.2/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Escherichia_coli_str_k_12_substr_mg1655/GCA_000005845.2/community/geneset/2018_09/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
