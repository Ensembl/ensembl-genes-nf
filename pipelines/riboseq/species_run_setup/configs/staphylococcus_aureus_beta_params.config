// Clean Ensembl Beta RiboSeq config for Staphylococcus aureus
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: N315 reference strain
// Beta species directory: Staphylococcus_aureus_subsp_aureus_n315
// Assembly: GCA_000009645.1
// Annotation provider: community
// Geneset date: 2016_10

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/staphylococcus_aureus_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/staphylococcus_aureus"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Staphylococcus aureus"
    ensembl_version = "beta_2016_10_GCA_000009645.1_community"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Staphylococcus_aureus_subsp_aureus_n315/GCA_000009645.1/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Staphylococcus_aureus_subsp_aureus_n315/GCA_000009645.1/community/geneset/2016_10/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
