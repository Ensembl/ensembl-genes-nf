// Clean Ensembl Beta RiboSeq config for Danio rerio
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: GRCz11 reference assembly; newer strain assemblies exist but are not the standard reference
// Beta species directory: Danio_rerio
// Assembly: GCA_000002035.4
// Annotation provider: ensembl
// Geneset date: 2018_04

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/danio_rerio_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/danio_rerio"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Danio rerio"
    ensembl_version = "beta_2018_04_GCA_000002035.4_ensembl"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Danio_rerio/GCA_000002035.4/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Danio_rerio/GCA_000002035.4/ensembl/geneset/2018_04/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
