// Ensembl pre-release RiboSeq config for Danio rerio
// Reference choice: GRCz13ab assembly GCA_052040795.2
// Annotation provider: Ensembl pre-release
// GTF timestamp: 2026-10-06

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/danio_rerio_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/danio_rerio"

    // Build references from Ensembl pre-release URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Danio rerio"
    ensembl_version = "pre_release_2026-10-06_GCA_052040795.2_pre_release"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/databases/ensembl/pre-release/Danio_rerio/GCA_052040795.2/danio_rerio_gca052040795v2.dna.softmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/databases/ensembl/pre-release/Danio_rerio/GCA_052040795.2/danio_rerio_gca052040795v2.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
