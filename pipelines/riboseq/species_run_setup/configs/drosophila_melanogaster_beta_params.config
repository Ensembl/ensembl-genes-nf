// Clean Ensembl Beta RiboSeq config for Drosophila melanogaster
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: FlyBase D. melanogaster reference
// Beta species directory: Drosophila_melanogaster
// Assembly: GCA_000001215.4
// Annotation provider: flybase
// Geneset date: 2022_07

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/drosophila_melanogaster_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/drosophila_melanogaster"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Drosophila melanogaster"
    ensembl_version = "beta_2022_07_GCA_000001215.4_flybase"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Drosophila_melanogaster/GCA_000001215.4/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Drosophila_melanogaster/GCA_000001215.4/flybase/geneset/2022_07/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
