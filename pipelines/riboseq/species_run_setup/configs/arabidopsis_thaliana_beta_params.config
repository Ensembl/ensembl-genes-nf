// Clean Ensembl Beta RiboSeq config for Arabidopsis thaliana
// Uses Ensembl Beta FTP new structure, not old release-number FTP/gget.
// Reference choice: newest Arabidopsis Beta assembly/geneset
// Beta species directory: Arabidopsis_thaliana
// Assembly: GCA_933208065.1
// Annotation provider: ensembl
// Geneset date: 2026_05

params {
    // Input/output
    sample_sheet = "/homes/jackt/riboseq_species_runs/sample_sheets/arabidopsis_thaliana_samplesheet.csv"
    outdir = "/hps/nobackup/flicek/ensembl/genebuild/jackt/riboseq/species_runs/arabidopsis_thaliana"

    // Build references from Ensembl Beta FTP URLs as part of this run.
    run_organism_setup = true
    auto_build_indices = false
    organism = "Arabidopsis thaliana"
    ensembl_version = "beta_2026_05_GCA_933208065.1_ensembl"
    download_method = "url"
    genome_fasta_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Arabidopsis_thaliana/GCA_933208065.1/genome/unmasked.fa.gz"
    genome_gtf_url = "https://ftp.ebi.ac.uk/pub/ensemblorganisms/Arabidopsis_thaliana/GCA_933208065.1/ensembl/geneset/2026_05/genes.gtf.gz"
    rrna_source = "gtf"

    // Data acquisition and read structure detection.
    fetch = true
    force_fetch = false
    rpf_extraction_method = "getrpf"
    getrpf_max_reads = 5000

    // Per-sample mode, not matrix mode.
    run_matrix_mode = false
    enable_unique_reads_tracking = false

    // Alignment defaults; override at CLI if needed.
    mismatches = 3
    alignment_type = "EndToEnd"
    allow_introns = true
    max_multimappers = 10
    min_mapq = 0

    // Keep rRNA filtering off unless explicitly requested.
    run_rrna_filter = false
}
