/*
 * Pipeline-level publication and module overrides.
 *
 * Keeping these selectors outside individual modules makes the modules
 * reusable and leaves output layout as a pipeline policy.
 */
process {
    withName: BAM_TO_BED {
        publishDir = [path: { "${params.outdir}/bedgraphs" }, mode: 'copy', pattern: '*.sorted.bedgraph']
    }

    withName: BEDGRAPH_TO_BIGWIG {
        publishDir = [
            path: { "${params.outdir}/bigwigs" },
            mode: 'copy',
            pattern: '*.bw',
            saveAs: { filename ->
                if (filename.contains('.good.')) {
                    return "good/${filename.replace('.good.', '.')}"
                }
                if (filename.contains('.great.')) {
                    return "great/${filename.replace('.great.', '.')}"
                }
                filename
            }
        ]
    }

    withName: BOWTIE_RRNA_FILTER {
        publishDir = [path: { "${params.outdir}/rrna_filter" }, mode: 'copy', pattern: '*_rrna_filter.log']
    }

    withName: BUILD_STUDY_MATRIX {
        publishDir = [path: { "${params.outdir}/studies" }, mode: 'copy']
    }

    withName: BUILD_STUDY_MATRIX_PARTITIONED {
        publishDir = [path: { "${params.outdir}/studies_partitioned" }, mode: 'copy']
    }

    withName: CHECK_CLEANLINESS {
        publishDir = [path: { "${params.outdir}/getRPF/check" }, mode: 'copy', pattern: '*_{report,rpf_checks}.txt']
    }

    withName: CHOROS {
        publishDir = [path: { "${params.outdir}/choros" }, mode: 'copy', pattern: '*.choros_*']
    }

    withName: COLLAPSE_FASTQ {
        publishDir = [path: { "${params.outdir}/collapsed_fa" }, mode: 'copy', pattern: '*collapsed.fa']
    }

    withName: COLLAPSED_TO_TSV {
        publishDir = [path: { "${params.outdir}/matrix" }, mode: 'copy']
    }

    withName: COLLAPSED_TO_TSV_PARTITIONED {
        publishDir = [path: { "${params.outdir}/matrix_partitioned" }, mode: 'copy']
    }

    withName: COLLATE_VERSIONS {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy']
    }

    withName: COLLECT_QC_METRICS {
        publishDir = [path: { "${params.outdir}/qc_gate" }, mode: 'copy', pattern: '*.qc_*.tsv']
    }

    withName: DETECT_ARCHITECTURE {
        publishDir = [path: { "${params.outdir}/getRPF/detect" }, mode: 'copy', pattern: '*.{seqspec.yaml,adapters.fa,extraction_report.json,fastq}']
    }

    withName: EXTRACT_RPFS {
        publishDir = [path: { "${params.outdir}/getRPF/extract" }, mode: 'copy', pattern: '*.{collapsed.fa,seqspec.yaml,extraction_report.json,report.html}']
    }

    withName: FASTP {
        publishDir = [path: { "${params.outdir}/fastp" }, mode: 'copy', pattern: '*.{json,html}']
    }

    withName: FASTQC {
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            saveAs: { filename -> filename.endsWith('.html') ? filename : null }
        ]
    }

    withName: FILTER_BAM {
        publishDir = [path: { "${params.outdir}/filtered_bams" }, mode: 'copy', pattern: '*.bam']
    }

    withName: FILTER_RPF_LENGTHS {
        publishDir = [path: { "${params.outdir}/getRPF/gated" }, mode: 'copy', pattern: '*.{collapsed.fa,summary.tsv}']
    }

    withName: FIND_ADAPTERS {
        publishDir = [path: { "${params.outdir}/adapter_reports" }, mode: 'copy', pattern: '*_adapter_report.fa']
    }

    withName: GENERATE_TRACKHUB {
        publishDir = [path: { "${params.outdir}/trackhubs" }, mode: 'copy']
    }

    withName: IMPORT_QC_DB {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy', pattern: 'qc.duckdb']
    }

    withName: LOCATE {
        publishDir = [path: { "${params.outdir}/pipeline_info/input_resolution" }, mode: 'copy', pattern: '*_input_resolution.tsv']
    }

    withName: MERGE_BEDGRAPHS {
        publishDir = [path: { "${params.outdir}/bedgraphs" }, mode: 'copy', pattern: '*.merged.*.sorted.bedgraph']
    }

    withName: MERGE_GLOBAL_MATRIX {
        publishDir = [path: { "${params.outdir}/global" }, mode: 'copy']
    }

    withName: MERGE_GLOBAL_MATRIX_PARTITIONED {
        publishDir = [path: { "${params.outdir}/global_partitioned" }, mode: 'copy']
    }

    withName: MERGE_UNIQUE_READS {
        publishDir = [
            path: { "${params.outdir}/unique_reads" },
            mode: 'copy',
            pattern: '*',
            saveAs: { filename ->
                filename.startsWith('unique_reads') ||
                filename.startsWith('count_matrix') ||
                filename.startsWith('read_mapping') ||
                filename.startsWith('processing_summary') ? filename : null
            }
        ]
    }

    withName: QC_GATE {
        publishDir = [path: { "${params.outdir}/qc_gate" }, mode: 'copy', pattern: '*.{offsets.pass.tsv,offsets.selected.tsv,offsets.good.tsv,offsets.great.tsv,pass_lengths.tsv,good.pass_lengths.tsv,great.pass_lengths.tsv,qc.json,qc_eval.tsv,qc_rule_set.tsv,gate_selection.tsv,translon.selected.txt}']
    }

    withName: QC_PARTITIONED_TSV {
        publishDir = [path: { "${params.outdir}/matrix_partition_qc" }, mode: 'copy']
    }

    withName: COLLECT_PARTITION_QC_MANIFEST {
        publishDir = [path: { "${params.outdir}/matrix_partition_qc" }, mode: 'copy']
    }

    withName: RIBODETECTOR {
        publishDir = [path: { "${params.outdir}/rrna_filter" }, mode: 'copy', pattern: '*_rrna_filter.log']
    }

    withName: RIBOMETRIC {
        publishDir = [
            path: { "${params.outdir}/RiboMetric" },
            mode: 'copy',
            pattern: '*',
            saveAs: { filename ->
                filename.endsWith('.offsets.tsv') || filename.endsWith('.best_offset.txt')
                    ? "offsets/${filename}"
                    : (filename.contains('RiboMetric.') ? filename : null)
            }
        ]
    }

    withName: RIBOWALTZ {
        publishDir = [
            path: { "${params.outdir}/ribowaltz" },
            mode: 'copy',
            pattern: '*.{tsv.gz,pdf}',
            saveAs: { filename -> filename.endsWith('.pdf') ? "offset_plot/${filename}" : filename }
        ]
    }

    withName: SAMPLE_COMPLETENESS {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy', pattern: 'sample_status.tsv']
    }

    withName: STAR_ALIGN {
        publishDir = [
            path: { "${params.outdir}/star_align" },
            mode: 'copy',
            saveAs: { filename ->
                (filename.contains('.Log.') || filename.endsWith('.SJ.out.tab')) ? "logs/${filename}" : null
            }
        ]
    }

    withName: STAR_ALIGN_UNIQUE_READS {
        publishDir = [path: { "${params.outdir}/global" }, mode: 'copy']
    }

    withName: STAR_ALIGN_UNIQUE_READS_PARTITIONED {
        publishDir = [path: { "${params.outdir}/global_partitioned" }, mode: 'copy']
    }

    withName: TRANSLONSCORER {
        publishDir = [path: { "${params.outdir}/translonscorer" }, mode: 'copy', pattern: '*']
    }

    withName: DOWNLOAD_SILVA {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: EXTRACT_RRNA {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: GENERATE_CHROM_SIZES {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: GENERATE_CONFIG {
        // Keep a stable, directly reusable reference config for subsequent runs.
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: 'copy',
            pattern: 'riboseq_params.config'
        ]
    }
    withName: GGET_DOWNLOAD {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: MAKE_TRANSCRIPTOME {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: RIBOMETRIC_PREPARE {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: URL_DOWNLOAD {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: BUILD_BOWTIE_INDEX {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
    withName: BUILD_STAR_INDEX {
        publishDir = [path: { "${params.outdir}/organism_setup" }, mode: 'copy']
    }
}
