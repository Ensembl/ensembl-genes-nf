includeConfig '../../nextflow.config'

manifest {
    name        = 'GenMap Mappability Pipeline'
    description = 'Calculate reference-genome mappability with GenMap.'
    version     = '0.1.0'
    nextflowVersion = '!>=26.04'
}

params {
    species    = null
    release    = 'current'
    reference_url = null
    reference  = null
    kmer       = 28
    mismatches = 0
    index_args = ''
    wig        = false
    csv        = false
    outdir     = 'results'
}

process {
    withName: 'FETCH_REFERENCE' {
        cpus = 1
        memory = 8.GB
        time = 2.h
    }
    withName: 'USE_LOCAL_REFERENCE' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    withName: 'GENMAP_INDEX' {
        cpus = 1
        memory = 64.GB
        time = 7.d
        ext.args = params.index_args
        ext.prefix = { "${meta.id}.index" }
        publishDir = [path: "${params.outdir}/index", mode: 'copy']
    }
    withName: 'GENMAP_MAP' {
        cpus = 1
        memory = 128.GB
        time = 7.d
        ext.args = "-K ${params.kmer} -E ${params.mismatches} -t -bg" + (params.wig ? ' -w' : '') + (params.csv ? ' -d' : '')
        ext.prefix = { meta.id }
        publishDir = [path: "${params.outdir}/mappability", mode: 'copy']
    }
    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        cpus = 1
        memory = 4.GB
        time = 2.h
        ext.prefix = { meta.id }
        publishDir = [path: "${params.outdir}/mappability", mode: 'copy']
    }
}

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
}

wave {
    enabled = true
    strategy = 'conda,container'
}
