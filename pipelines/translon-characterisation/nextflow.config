includeConfig '../../nextflow.config'

plugins { id 'nf-schema@2.2.0' }

manifest {
    name = 'translon-characterisation'
    description = 'Attribution-correct, transcript-contingent characterisation of trusted translons'
    version = '0.1.0'
}

params {
    intervals = null
    gencode_gff3 = null
    translation_verdicts = null
    proteome_fasta = null
    expression_table = null
    observed_peptides = null
    outdir = './results'
    tools_manifest = null
    reference_contract = "${projectDir}/assets/production-reference-contract.json"
    // Heavy-tool inputs are deliberately explicit and can be added without changing the schema.
    genome_fasta = null
    ucsc_container = 'quay.io/biocontainers/ucsc-bigbedtobed@sha256:aea2a8e7a31957eebece9a309b7aa1e487f101240eb71a4925e99a7e4c580bf5'
    whole_genome_alignment = null
    gnomad = null
    gnomad_coverage = null
    gpn_model = null
    gpn_star_primate_model = 'songlab/gpn-star-hg38-p243-200m'
    gpn_star_primate_revision = '16773016130e826cd3d72e91ed312a3cb27ba2b5'
    gpn_star_mammal_model = 'songlab/gpn-star-hg38-m447-200m'
    gpn_star_mammal_revision = '0d8f5164fba8e8108200c160370b86652bfb6244'
    gpn_star_alignment_dataset = 'songlab/hg38_cactus447way'
    gpn_star_alignment_revision = 'f523f0467bc143b62fb5b3b9a91c510e8dc2a7f6'
    maf_dir = null
    maf_pattern = '*.maf'
    maf_index_suffix = '.maf.bb'
    maf_reference_manifest = "${projectDir}/assets/hg38.multiz100way.primary.maf.jsonl"
    msa_extract_container = 'oras://community.wave.seqera.io/library/python:3.12-slim'
    phylocsf_model = '58mammals'
    phylocsf_matched_null = null
    phylocsf_container = 'quay.io/biocontainers/phylocsf@sha256:416bb1f7e1fade714091dfea775f7a9d4f4a4c1bada91d0747ae4e3caa3bcd91'
    phylocsf_strategy = 'mle'
    phylocsf_species_map = "${projectDir}/assets/hg38.multiz100way.58mammals.tsv"
    alignment_reference = 'Human'
    orbl_alignment_set = 'hg38_120mammals'
    orbl_container = 'translon-characterisation-orbl:1.0.0'
    product_clustering_container = 'quay.io/biocontainers/mmseqs2:15-6f452--pl5321h6a68c12_0'
    product_cluster_min_seq_id = 0.9
}

process {
    withLabel: process_gpu {
        cpus = 4
        memory = '32.GB'
        time = '12.h'
        accelerator = 1
    }
    withName: 'PRODUCT_CLUSTERING' { cpus = 8; memory = '48.GB'; time = '12.h' }
}

// This workflow stages references and model caches outside the launch
// directory, so container inputs must be mounted explicitly on HPC systems.
singularity {
    autoMounts = true
    cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity-cache"
}

profiles {
    docker { docker.enabled = true }
    singularity { singularity.enabled = true }
    local { process.executor = 'local' }
    slurm {
        process.executor = 'slurm'
        docker.enabled = false
        singularity.enabled = true
    }
}
