/*
========================================================================================
    GFF3_TO_CORE PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    // Input
    input_gff3          = null    // final geneset GFF3 from finalise_geneset
    genome_fai          = null    // samtools .fai index for seq_region loading; optional
    synonyms_tsv        = null    // seq-region synonyms TSV from load_assembly; optional

    // Ensembl core DB connection
    db_host             = null
    db_port             = 3306
    db_user             = null
    db_password         = ''
    db_name             = null    // e.g. homo_sapiens_core_109_38

    // Genome / species metadata
    assembly            = null    // e.g. GRCh38
    species_name        = 'species'
    species_id          = 1
    stable_id_prefix    = ''     // empty for human; 'GAL' for chicken, etc.
    analysis_logic_name = 'ensembl_genebuild'
    coord_system        = 'chromosome'

    outdir              = null
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'LOAD_GFF3_TO_CORE' {
        cpus       = 1
        memory     = { 4.GB * task.attempt }
        time       = '8.h'
        maxRetries = 1
    }
    withName: 'ASSIGN_STABLE_IDS' {
        cpus       = 1
        memory     = '2.GB'
        time       = '2.h'
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '5.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 1 }
        singularity.enabled = false
        docker.enabled      = false
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
}
