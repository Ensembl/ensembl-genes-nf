/*
========================================================================================
    IGTR PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Pipeline-specific parameters
params {
    genome_fasta       = null   // softmasked genome FASTA (from repeat_masking)
    igtr_proteins      = null   // IMGT IG/TR protein FASTA
    outdir             = null

    // GenBlast parameters (match IGTR_subpipeline.pm defaults)
    genblast_max_rank  = 5
    protein_batch_size = 10     // proteins per GenBlast job

    // Filtering thresholds
    min_pid            = 70     // minimum percent identity
    min_coverage       = 80     // minimum query coverage (%)
}

// Process-specific configuration
process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }

    withName: 'RUN_IGTR:GENBLAST' {
        ext.args   = '-P blast -gff -e 1 -c 0.8 -W 3 -softmask -scodon 50 -i 30 -x 10 -n 30 -d 200000 -num_threads 3 -window_size 40'
        cpus       = 3
        memory     = { 4.GB * task.attempt }
        time       = '2.h'
        maxRetries = 2
    }
    withName: 'RUN_IGTR:CONVERT_GENBLAST' {
        memory = '1.GB'
        time   = '30.m'
    }
    withName: 'RUN_IGTR:CLUSTER_IGTR' {
        memory = '2.GB'
        time   = '30.m'
    }
}

// Execution profiles
profiles {
    slurm {
        process {
            executor = 'slurm'
        }
    }
    local {
        process {
            executor = 'local'
            maxForks = 4
        }
        singularity {
            cacheDir = './singularity_cache'
        }
    }
    conda {
        conda {
            enabled       = true
            useMicromamba = true
            cacheDir      = './conda_cache'
        }
        singularity.enabled = false
    }
    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        singularity.enabled = false
    }
}
