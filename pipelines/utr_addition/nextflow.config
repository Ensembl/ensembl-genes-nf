/*
========================================================================================
    UTR_ADDITION PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    consolidated_gff3   = null   // required: coding gene models (from consolidate pipeline)
    donor_gff3_files    = null   // required: comma-separated GFF3 files with UTR donors
                                 //           ordered by priority: long_read first, then cDNA, then rnaseq
    outdir              = null

    // UTR extension limits
    max_5prime_utr      = 5000   // max 5' UTR length (bp)
    max_3prime_utr      = 10000  // max 3' UTR length (bp)
    min_utr_exon_size   = 30     // minimum UTR exon size (bp) to accept
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'ADD_UTRS' {
        cpus       = 4
        memory     = { 8.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity.enabled = false
        docker.enabled      = false
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
