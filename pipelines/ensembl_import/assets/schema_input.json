{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ensembl Import Sample Sheet",
  "description": "RefSeq assemblies to import into Ensembl core databases",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "gcf": {
        "type": "string",
        "pattern": "^(GCA|GCF)_[0-9]+\\.[0-9]+$",
        "description": "RefSeq assembly accession"
      },
      "species": {
        "type": "string",
        "minLength": 1,
        "description": "Binomial species name"
      }
    },
    "required": ["gcf", "species"],
    "additionalProperties": false
  },
  "minItems": 1
}
