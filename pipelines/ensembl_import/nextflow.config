// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    outdir               = './results' // is this already set in the base config?
    input_csv            = null   // path to the CSV of gffs
    server_settings      = null  // path to server settings json
    genebuilder          = 'automated'
    skip_start_check     = 'false'
}

process {
    executor = 'slurm'

    withName: LOAD_REFSEQ {
        cpus = 1
        memory = { 10.GB }
        time = { 4.h }
        maxForks = 4
        errorStrategy = 'finish'
        maxRetries = 0
    }

    withName: FETCH_REFSEQ {
        maxForks = 4
    }

    withName: DOWNLOAD_REPEATMASKER {
        maxForks = 4
    }

    withName: CONVERT_REPEATMASKER {
        maxForks = 4
    }

    withName: LOAD_REPEATMASKER {
        cpus = 1
        memory = { 10.GB }
        time = { 4.h }
        maxForks = 4
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: LOAD_TAXONOMY {
        maxForks = 1
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: REGISTRY_TRACKER_START {
        maxForks = 4
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: REGISTRY_TRACKER_COMPLETE {
        maxForks = 4
        errorStrategy = 'terminate'
        maxRetries = 0
    }
}

// Execution profiles. Slurm is the default; local is available for stub/dev checks.
profiles {
    slurm {
        process {
            executor = 'slurm'
        }
    }

    local {
        process {
            executor = 'local'
            maxForks = 2
        }
    }
}
