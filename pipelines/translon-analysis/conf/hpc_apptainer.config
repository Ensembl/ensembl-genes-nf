params {
    ribotie_slurm_partition        = System.getenv('TRANSLON_RIBOTIE_GPU_PARTITION') ?: 'gpu'
    ribotie_slurm_gres             = System.getenv('TRANSLON_RIBOTIE_GPU_GRES') ?: 'gpu:1'
    ribotie_slurm_qos              = System.getenv('TRANSLON_RIBOTIE_GPU_QOS')
}

// Required for the GPU-backed RiboTIE process; exposes the host NVIDIA runtime
// inside the process-local CUDA container.
singularity.runOptions = '--nv'
apptainer.runOptions = '--nv'
