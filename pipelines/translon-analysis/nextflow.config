/*
========================================================================================
    TRANSLON ANALYSIS PIPELINE CONFIGURATION
========================================================================================
    Downstream ORF discovery, caller reconciliation and translon characterisation.
    The upstream contract is the published output tree from pipelines/riboseq.
========================================================================================
*/

includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    gedi_reference_id = 'reference'
    outdir = './results/translon-analysis'
    tracedir = "${params.outdir}/pipeline_info"

    riboseq_outdir = null
    samplesheet = null
    transcriptome_bam_glob = null
    genome_bam_glob = null
    qc_pass_lengths_dir = null
    offsets_glob = null
    translonscorer_glob = null
    merge_inputs = false
    merge_group = 'all'
    skip_fastq_tools = false

    gtf = null
    canonical_gtf = null
    fasta = null
    ribometric_annotation = null
    ribometric_offset_method = 'tripsviz'
    ribometric_offset_target = 'a_site'
    ribometric_offset_global = null
    ribometric_sample_size = 10000000
    proteome_fasta = null
    tools = 'all'
    min_caller_agreement = 2
    run_characterisation = true

    args_ribocode = ''
    args_ribotricer = ''
    ribosomal_fasta = null
    adapter_fasta = null
    adapter_sequence = null
    command_orfquant = null
    read_lengths_orfquant = '27,28,29,30'
    psite_offsets_orfquant = '12,12,12,12'
    command_rpbp = null
    args_ribotish = ''
    ribotie_gpu = false
    ribotie_slurm_partition = 'gpu'
    ribotie_slurm_gres = 'gpu:1'
    ribotie_slurm_qos = null
    args_iribo = ''
    args_orfrater = ''
    args_riborf = ''
    args_ribotie = ''
    orfrater_model = null

    ucsc_container = 'quay.io/biocontainers/ucsc-bigbedtobed@sha256:aea2a8e7a31957eebece9a309b7aa1e487f101240eb71a4925e99a7e4c580bf5'
    msa_extract_container = 'oras://community.wave.seqera.io/library/python:3.12-slim'
    phylocsf_container = 'quay.io/biocontainers/phylocsf@sha256:416bb1f7e1fade714091dfea775f7a9d4f4a4c1bada91d0747ae4e3caa3bcd91'
    orbl_container = 'translon-characterisation-orbl:1.0.0'
    product_clustering_container = 'quay.io/biocontainers/mmseqs2:15-6f452--pl5321h6a68c12_0'
    maf_reference_manifest = null
    maf_dir = null
    phylocsf_matched_null = null
    orbl_alignment_set = null
    product_cluster_min_seq_id = 0.9
    ucsc_session_url = 'hg38'
}

timeline {
    enabled = true
    file = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.tracedir}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}

process {
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries = 3

    // The consensus bridge inherits the repository-wide process_high class,
    // which is appropriate for the production cohort but prevents local
    // validation on the mini fixture. The local profile can override this
    // again if a larger test is explicitly requested.
    withName: 'REPORT_CONSENSUS' {
        cpus = 2
        memory = '4.GB'
        errorStrategy = 'terminate'
    }
    withName: 'RUN_RIBOTIE' {
        // Restrict only RiboTIE to the GPU partition. Other callers remain on
        // the normal CPU partition. Override these values for Codon's exact
        // partition/GRES names via the command line or HPC config.
        clusterOptions = [
            params.ribotie_slurm_partition ? "--partition=${params.ribotie_slurm_partition}" : null,
            params.ribotie_slurm_gres ? "--gres=${params.ribotie_slurm_gres}" : null,
            params.ribotie_slurm_qos ? "--qos=${params.ribotie_slurm_qos}" : null
        ].findAll { it != null }.join(' ')
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
        apptainer.enabled = false
    }
    apptainer {
        process.executor = 'local'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('NXF_APPTAINER_CACHEDIR') ?: '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
        singularity.enabled = false
    }
    slurm_apptainer {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('NXF_APPTAINER_CACHEDIR') ?: '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
        singularity.enabled = false
    }
    local {
        process.executor = 'local'
        process.maxForks = 2
        process {
            withName: 'RUN_IRIBO' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_ORFRATER' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_RIBORF' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_RIBOTIE' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_ORFQUANT' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_RIBOTISH' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'GEDI_INDEXGENOME' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'GEDI_PRICE' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
        }
        singularity.enabled = false
    }
    conda {
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = './conda_cache'
        singularity.enabled = false
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withName: 'RUN_IRIBO' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
        }
        singularity.enabled = false
    }
}

process {
    // Production HPC sizing for the collapsed-read cohort. These overrides
    // keep the local profile small while giving the real callers enough room
    // for inflated BAMs and their in-memory indexes.
    withName: 'MERGE_RIBO_BAMS' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'INFLATE_UNIQUE_BAM' {
        cpus = 8
        memory = '32.GB'
        time = '48.h'
    }
    withName: 'RIBOMETRIC' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'RUN_RIBOCODE' {
        cpus = 8
        memory = '64.GB'
        time = '48.h'
    }
    withName: 'RUN_RIBOTRICER' {
        cpus = 8
        memory = '128.GB'
        time = '48.h'
    }
    withName: 'RUN_ORFQUANT' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'RUN_RPBP' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'RUN_IRIBO' {
        cpus = 8
        memory = '256.GB'
        time = '48.h'
    }
    withName: 'RUN_RIBOTISH' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'STANDARDISE_CALLER' {
        cpus = 2
        memory = '8.GB'
        time = '4.h'
    }
    withName: 'RUN_ORFRATER' {
        cpus = 8
        memory = '64.GB'
        time = '48.h'
    }
    withName: 'RUN_RIBORF' {
        cpus = 8
        memory = '64.GB'
        time = '24.h'
    }
    withName: 'RUN_RIBOTIE' {
        cpus = 8
        memory = '128.GB'
        time = '48.h'
    }
    withName: 'GEDI_PRICE' {
        cpus = 8
        memory = '256.GB'
        time = '48.h'
    }
}
