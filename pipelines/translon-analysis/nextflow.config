/*
========================================================================================
    TRANSLON ANALYSIS PIPELINE CONFIGURATION
========================================================================================
    Downstream ORF discovery, caller reconciliation and translon characterisation.
    The upstream contract is the published output tree from pipelines/riboseq.
========================================================================================
*/

includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    gedi_reference_id = 'reference'
    outdir = './results/translon-analysis'
    tracedir = "${params.outdir}/pipeline_info"

    riboseq_outdir = null
    samplesheet = null
    transcriptome_bam_glob = null
    genome_bam_glob = null
    qc_pass_lengths_dir = null
    offsets_glob = null
    translonscorer_glob = null
    merge_inputs = false
    merge_group = 'all'
    skip_fastq_tools = false

    gtf = null
    canonical_gtf = null
    fasta = null
    proteome_fasta = null
    tools = 'all'
    min_caller_agreement = 2
    run_characterisation = true

    threads_ribocode = 4
    threads_ribotricer = 4
    threads_orfquant = 4
    threads_rpbp = 4
    threads_iribo = 2
    memory_iribo = '64.GB'
    threads_orfrater = 2
    threads_riborf = 2
    threads_ribotish = 2
    threads_ribotie = 2

    container_ribocode = 'quay.io/biocontainers/ribocode:1.2.15--pyhdc42f0e_1'
    args_ribocode = ''
    container_ribotricer = 'quay.io/biocontainers/ribotricer:1.5.0--pyhdfd78af_0'
    args_ribotricer = ''
    container_orfquant = 'translon-analysis/orfquant:1.1.0-txdbmaker2'
    container_rpbp = 'quay.io/biocontainers/rpbp:3.0.1--py310h30d9df9_0'
    container_samtools = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0'
    container_transcript_models = 'python:3.12-slim'
    container_gedi_price = 'translon-analysis/gedi-price:1.0.6a-samtools'
    ribosomal_fasta = null
    adapter_fasta = null
    adapter_sequence = null
    command_orfquant = null
    read_lengths_orfquant = '27,28,29,30'
    psite_offsets_orfquant = '12,12,12,12'
    command_rpbp = null
    container_ribotish = 'quay.io/biocontainers/ribotish:0.2.8--pyhdfd78af_0'
    args_ribotish = ''
    container_iribo = null
    container_orfrater = null
    container_riborf = null
    container_ribotie = null
    args_iribo = ''
    args_orfrater = ''
    args_riborf = ''
    args_ribotie = ''
    orfrater_model = null

    ucsc_container = 'quay.io/biocontainers/ucsc-bigbedtobed@sha256:aea2a8e7a31957eebece9a309b7aa1e487f101240eb71a4925e99a7e4c580bf5'
    msa_extract_container = 'oras://community.wave.seqera.io/library/python:3.12-slim'
    phylocsf_container = 'quay.io/biocontainers/phylocsf@sha256:416bb1f7e1fade714091dfea775f7a9d4f4a4c1bada91d0747ae4e3caa3bcd91'
    orbl_container = 'translon-characterisation-orbl:1.0.0'
    product_clustering_container = 'quay.io/biocontainers/mmseqs2:15-6f452--pl5321h6a68c12_0'
    maf_reference_manifest = null
    maf_dir = null
    phylocsf_matched_null = null
    orbl_alignment_set = null
    product_cluster_min_seq_id = 0.9
    ucsc_session_url = 'hg38'
}

timeline {
    enabled = true
    file = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.tracedir}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries = 1

    // The consensus bridge inherits the repository-wide process_high class,
    // which is appropriate for the production cohort but prevents local
    // validation on the mini fixture. The local profile can override this
    // again if a larger test is explicitly requested.
    withName: 'REPORT_CONSENSUS' {
        cpus = 2
        memory = '4.GB'
        errorStrategy = 'terminate'
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
        apptainer.enabled = false
    }
    apptainer {
        process.executor = 'local'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('NXF_APPTAINER_CACHEDIR') ?: '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
        singularity.enabled = false
    }
    slurm_apptainer {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('NXF_APPTAINER_CACHEDIR') ?: '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
        singularity.enabled = false
    }
    local {
        params.memory_iribo = '4.GB'
        process.executor = 'local'
        process.maxForks = 2
        process {
            withName: 'RUN_IRIBO' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_ORFRATER' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_RIBORF' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_RIBOTIE' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_ORFQUANT' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'RUN_RIBOTISH' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'GEDI_INDEXGENOME' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
            withName: 'GEDI_PRICE' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
        }
        singularity.enabled = false
    }
    conda {
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = './conda_cache'
        singularity.enabled = false
    }
    docker {
        params.memory_iribo = '4.GB'
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withName: 'RUN_IRIBO' {
                cpus = 2
                memory = '4.GB'
                time = '2.h'
            }
        }
        singularity.enabled = false
    }
}

process {
    withName: 'RUN_IRIBO' {
        cpus = 8
        memory = params.memory_iribo
        time = '24.h'
    }
    withName: 'RUN_ORFRATER' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'RUN_RIBORF' {
        cpus = 4
        memory = '32.GB'
        time = '24.h'
    }
    withName: 'RUN_RIBOTIE' {
        cpus = 8
        memory = '64.GB'
        time = '24.h'
    }
    withName: 'GEDI_PRICE' {
        cpus = 8
        memory = '128.GB'
        time = '48.h'
    }
}
