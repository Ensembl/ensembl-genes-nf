/*
========================================================================================
    FINALISE_GENESET PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    input_gff3              = null   // required: GFF3 from utr_addition (or consolidate)
    repeat_gff3             = null   // required: repeat GFF3 from repeat_masking pipeline
    selenoprotein_fasta     = null   // optional: FASTA of selenoprotein sequences (triggers selenoprotein step)
    outdir                  = null

    min_orf_aa              = 100    // minimum CDS length in amino acids
    min_intron_size         = 10     // introns shorter than this are flagged as frameshifted
    max_repeat_cds_coverage = 0.80  // fraction of CDS covered by repeats → pseudogene
    max_readthrough_gap     = 10000  // max intergenic distance to flag readthrough
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'FILTER_GENESET' {
        cpus       = 4
        memory     = { 8.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'DETECT_PSEUDOGENES' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'DETECT_READTHROUGH' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'FLAG_SELENOPROTEINS' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'SELECT_CANONICAL' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity.enabled = false
        docker.enabled      = false
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
