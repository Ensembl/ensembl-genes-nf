/*
========================================================================================
    GENBLAST_HOMOLOGY PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    genome_fasta       = null   // softmasked genome FASTA
    uniprot_fasta      = null   // UniProt protein FASTA (clade-specific set)
    uniprot_set        = ''     // informational: e.g. 'mammals_basic'
    outdir             = null

    // GenBlast parameters (match GenblastHomology.pm defaults for NCBI BLAST)
    genblast_max_rank  = 5
    protein_batch_size = 15     // proteins per GenBlast job

    // Filtering thresholds (more permissive than IGTR)
    min_pid            = 30
    min_coverage       = 50
}

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }

    withName: 'RUN_HOMOLOGY:GENBLAST' {
        // More permissive than IGTR: e=1e-1, c=0.5 vs e=1, c=0.8
        ext.args   = '-P blast -gff -e 1e-1 -c 0.5 -W 3 -softmask -scodon 50 -i 30 -x 10 -n 30 -d 200000 -num_threads 3 -window_size 40'
        cpus       = 3
        memory     = { 4.GB * task.attempt }
        time       = '2.h'
        maxRetries = 2
    }
    withName: 'RUN_HOMOLOGY:CLASSIFY_GENBLAST' {
        memory = '1.GB'
        time   = '30.m'
    }
    withName: 'RUN_HOMOLOGY:REMOVE_REDUNDANT' {
        memory = '4.GB'
        time   = '1.h'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity.enabled = false
        docker.enabled      = false
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
