/*
========================================================================================
    AB INITIO PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    genome_fasta          = null   // softmasked genome FASTA
    species               = null   // Augustus species model (e.g. 'human', 'fly')
    outdir                = null

    // Genome chunking
    chunk_size            = 50     // sequences per FASTA chunk

    // Augustus optional config
    augustus_config_path  = null   // path to Augustus config/ dir (for custom models)
    extrinsic_cfg         = null   // extrinsic.M.RM.E.W.cfg for hints-guided mode

    // Filtering
    min_gene_length       = 100    // minimum gene span in bp to retain
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'AUGUSTUS' {
        cpus       = 2
        memory     = { 4.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'PARSE_AUGUSTUS' {
        memory = '1.GB'
        time   = '30.m'
    }
    withName: 'MERGE_AB_INITIO' {
        memory     = { 4.GB * task.attempt }
        time       = '1.h'
        maxRetries = 1
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
