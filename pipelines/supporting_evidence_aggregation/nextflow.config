includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    track_manifest = null
    manifest_base_dir = null
    track_types = 'all'
    source_entity_type = 'run'
    species_name = null
    allow_opaque_normalization = false
    coverage_bin_size = 1000
    outdir = './results'
}

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.autoMounts = true
    }
    test {
        process.executor = 'local'
        process.maxForks = 2
    }
}
