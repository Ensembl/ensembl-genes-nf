/*
========================================================================================
    REFSEQ_IMPORT PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    assembly_refseq_accession = null  // e.g. GCF_000001405.40
    assembly_name             = null  // e.g. GRCh38.p14
    synonyms_tsv              = null  // optional: RefSeq accession → chr name TSV
    keep_patches              = false // include NT_/NW_ scaffold sequences
    outdir                    = null
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'DOWNLOAD_REFSEQ' {
        memory     = { 1.GB * task.attempt }
        time       = '2.h'
        maxRetries = 2   // retry download on network failure
    }
    withName: 'PARSE_REFSEQ' {
        memory     = { 8.GB * task.attempt }
        time       = '2.h'
        maxRetries = 1
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
