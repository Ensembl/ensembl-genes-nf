/*
========================================================================================
    RNASEQ PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    genome_fasta     = null   // unmasked genome FASTA (for STAR index)
    star_index       = null   // pre-built STAR index directory (skips index step)
    annotation_gtf   = null   // optional: annotation GTF for STAR sjdbGTFfile
    sample_sheet     = null   // CSV: id,fastq_1[,fastq_2][,strandedness]
    outdir           = null

    // STAR index
    sjdb_overhang    = 99     // --sjdbOverhang (read_length - 1)

    // StringTie2 assembly
    stringtie_min_length   = 200    // -m
    stringtie_min_coverage = 2.0    // -c

    // GFF3 filtering
    rnaseq_min_length = 200
    rnaseq_min_exons  = 1
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'STAR_INDEX' {
        cpus       = 12
        memory     = { 40.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'ALIGN_AND_ASSEMBLE:STAR_ALIGN' {
        cpus       = 12
        memory     = { 40.GB * task.attempt }
        time       = '8.h'
        maxRetries = 1
    }
    withName: 'ALIGN_AND_ASSEMBLE:STRINGTIE' {
        cpus       = 4
        memory     = { 8.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'ALIGN_AND_ASSEMBLE:FILTER_STRINGTIE' {
        memory = '1.GB'
        time   = '30.m'
    }
    withName: 'MERGE_RNASEQ' {
        memory     = { 8.GB * task.attempt }
        time       = '2.h'
        maxRetries = 1
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
