/*
========================================================================================
    CONSOLIDATE PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    gff3_dir          = null    // directory containing *.gff3 files
    gff3_files        = null    // glob or list of GFF3 files (alternative to gff3_dir)
    outdir            = null

    // JSON map of filename pattern → priority (lower = higher priority)
    // Override at runtime to match your actual filenames
    layer_priorities  = '''{
        "long_read":     0,
        "best_targeted": 1,
        "rnaseq":        2,
        "projection":    3,
        "refseq":        4,
        "ab_initio":     5,
        "genblast":      6
    }'''
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'CONSOLIDATE_GENES' {
        cpus       = 2
        memory     = { 8.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
