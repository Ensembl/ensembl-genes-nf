includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    input_manifest = null
    stage_dir = './funannotate-stage'
    outdir = './results'
    funannotate_db = null
    cpus = 8
    funannotate_container = null
    samtools_container = 'https://depot.galaxyproject.org/singularity/samtools:1.20--h50ea8bc_1'
    augustus_species = null
    parameters = null
    soft_mask = 2000
    min_training_models = 200
    busco_db = null
    extra_predict_args = ''
}

process {
    withName: STAGE_FTP_FILES {
        errorStrategy = 'retry'
        maxRetries = 2
    }
    withName: INDEX_AND_VALIDATE_BAMS {
        container = { params.samtools_container }
    }
    withName: RUN_FUNANNOTATE {
        container = { params.funannotate_container }
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        process {
            withName: STAGE_FTP_FILES {
                queue = 'datamover'
                maxForks = 4
                time = '12h'
            }
        }
    }
    test {
        process.executor = 'local'
        process.maxForks = 2
        process {
            withName: INDEX_AND_VALIDATE_BAMS {
                container = null
            }
            withName: RUN_FUNANNOTATE {
                container = null
            }
        }
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
    }
}
