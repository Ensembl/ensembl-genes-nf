includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    input_manifest = null
    stage_dir = './funannotate-stage'
    outdir = './results'
    cpus = 8
}

process {
    executor = 'slurm'

    withName: STAGE_FTP_FILES {
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: MERGE_BAMS {
        cpus = params.cpus
    }

    withName: CONVERT_CRAMS {
        cpus = params.cpus
    }

    withName: RUN_FUNANNOTATE {
        cpus = params.cpus
    }
}

profiles {
    slurm {
        process {
            withName: STAGE_FTP_FILES {
                queue = 'datamover'
                maxForks = 4
                time = 12.h
            }
        }
    }
    local {
        process.executor = 'local'
        process.maxForks = 2
        process {
            withName: STAGE_FTP_FILES {
                container = null
            }
            withName: INDEX_AND_VALIDATE_BAMS {
                container = null
            }
            withName: MERGE_BAMS {
                container = null
            }
            withName: CONVERT_PROTEIN_ALIGNMENTS {
                container = null
            }
            withName: TRANSFORM_SCALLOP {
                container = null
            }
            withName: RUN_FUNANNOTATE {
                container = null
                memory = 4.GB
            }
        }
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
    }
}
