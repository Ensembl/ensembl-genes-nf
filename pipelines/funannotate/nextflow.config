includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    input_manifest = null
    stage_dir = './funannotate-stage'
    outdir = './results'
    funannotate_db = null
    cpus = 8
    stage_container = 'docker.io/curlimages/curl:8.12.1@sha256:88a9abad9d958340e48564f9bdcdaa29916a2984be59314da709f8bbc0eef6f7'
    gffread_container = '/nfs/production/flicek/ensembl/shared_data/singularity_images/cache/gffread_latest.sif'
    funannotate_container = null
    augustus_species = null
    parameters = null
    soft_mask = 2000
    min_training_models = 200
    busco_db = null
    extra_predict_args = ''
}

process {
    withName: STAGE_FTP_FILES {
        errorStrategy = 'retry'
        maxRetries = 2
    }
    withName: MERGE_BAMS {
        cpus = params.cpus.toString().toInteger()
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        process {
            withName: STAGE_FTP_FILES {
                queue = 'datamover'
                maxForks = 4
                time = '12h'
            }
        }
    }
    test {
        process.executor = 'local'
        process.maxForks = 2
        process {
            withName: STAGE_FTP_FILES {
                container = null
            }
            withName: INDEX_AND_VALIDATE_BAMS {
                container = null
            }
            withName: MERGE_BAMS {
                container = null
            }
            withName: CONVERT_PROTEIN_ALIGNMENTS {
                container = null
            }
            withName: TRANSFORM_STRINGTE {
                container = null
            }
            withName: RUN_FUNANNOTATE {
                container = null
            }
        }
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
    }
}
