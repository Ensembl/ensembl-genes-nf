includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    track_manifest = null
    aggregation_manifest = null
    manifest_base_dir = null
    chrom_sizes = null
    track_types = 'all'
    allow_opaque_normalization = false
    outdir = './results'
}

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.autoMounts = true
    }
    test {
        process.executor = 'local'
        process.maxForks = 2
    }
}
