includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    manifest = null
    taxon_id = null
    tree = false
    discovery_probe = true
    target_sample_count = 8
    soft_download_budget = 250.0
    soft_raw_subread_budget = 1
    discovery_cache_dir = null
    approved_manifest = null
    auto_approve_safe = false
    metadata_json = null
    metadata_cache_dir = null
    fastq_cache_dir = null
    reference_fasta = null
    reference_fai = null
    minimap_index = null
    cohort_id = 'bos_indicus_long_read'
    model_backend = 'tama'
    outdir = './long_read_tama_results'
    minimap2_preset = 'splice:hq'
    secondary_mode = 'no'
    samtools_sort_memory = '2G'
    tama_container = null
    tama_cap_mode = 'no_cap'
    tama_end_mode = 'common_ends'
    tama_run_mode = 'low_mem'
    merge_tool = 'tama'
    tmerge_args = ''
    ccs_container = null
    ccs_command = 'ccs'
    ccs_args = ''
    ccs_expected_version = null
    // Split sorted BAMs by reference contig before TAMA by default. Use
    // --shard_mode none only for deliberately small inputs.
    shard_mode = 'contig'
    shard_contig_reads = 1000000
    tama_memory_small = '128.GB'
    tama_memory_large = '256.GB'
    tama_memory_very_large = '512.GB'
    run_diamond_validation = false
    diamond_reference_db = null
    diamond_reference_proteins = null
    diamond_classification_type = 'long_read'
    ensembl_genes_container = 'dockerhub.ebi.ac.uk/ensembl_genebuild/ensembl-genes-containers/ensembl-genes'
    transcriptomic_data_command = 'python3 -m ensembl.genes.transcriptomic_data.get_transcriptomic_data'
}

process {
    // Keep this pipeline moving: every process gets bounded retries and then
    // is ignored. Failures remain available in the Nextflow trace/report.
    errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
    maxRetries = 5
    maxErrors = 1
    // Label selectors from the shared resource config otherwise override the
    // generic process policy, so repeat the baseline at label scope.
    withLabel: 'process_light|process_low|process_medium|process_high|process_high_memory|process_long|process_single_long' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_light' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_low' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_medium' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_high' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_high_memory' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_long' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_single_long' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withName: 'FASTQ_DL|ACQUIRE_LONG_READ_BAM' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withName: 'STATS_FASTQ|PROBE_FASTQ|VALIDATE_FASTQ_RECORDS|AUDIT_FASTQ|STAGE_VALIDATED_FASTQ' {
        // A single accession may be corrupt or incompatible. Retry resource
        // failures, then skip that accession while other runs continue.
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withName: 'TAMA_COLLAPSE' {
        // The adapter records every TAMA exit status and returns success so a
        // failed shard is non-terminal and does not get retried invisibly.
        time = 96.h
        errorStrategy = 'ignore'
        maxRetries = 0
    }
    withName: '.*:TAMA_COLLAPSE' {
        errorStrategy = 'ignore'
        maxRetries = 0
    }

    // Scale allocations on retry for other processes. All exhausted process
    // failures are non-terminal; process reports and status outputs preserve
    // the diagnostics needed to identify affected inputs.
    withName: 'DISCOVER_LONG_READ_DATA|INSPECT_LONG_READ_MANIFEST|AUTO_APPROVE_SELECTED_LONG_READS|VALIDATE_APPROVED_LONG_READ_MANIFEST|VALIDATE_LONG_READ_MANIFEST|RESOLVE_LONG_READ_METADATA|VALIDATE_FASTQ|VALIDATE_LONG_READ_MODELS' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'FASTQ_DL' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'BUILD_MINIMAP2_INDEX|EXTRACT_COMBINED_TRANSCRIPTS|PREDICT_LONGEST_ATG_ORFS|REPORT_COMBINED_DIAMOND_MODELS' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'MINIMAP2_ALIGN|SAMTOOLS_SORT_INDEX|ALIGNMENT_QC|SPLIT_BAM_BY_CONTIG|BAM_TO_ALIGNMENT_GTF' {
        memory = { 60.GB * task.attempt }
    }
    withName: 'RUN_PBCCS|BAM_TO_FASTQ|ACQUIRE_LONG_READ_BAM|TAMA_MERGE|TAMA_MERGE_ACCESSION|TMERGE|TMERGE_ACCESSION' {
        memory = { 64.GB * task.attempt }
    }
    withName: 'STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|BAM_TO_ALIGNMENT_GTF|TMERGE_COLLAPSE' {
        memory = { 64.GB * task.attempt }
    }

    withName: 'DISCOVER_LONG_READ_DATA' {
        publishDir = "${params.outdir}/discovery"
    }
    withName: 'VALIDATE_LONG_READ_MANIFEST|VALIDATE_APPROVED_LONG_READ_MANIFEST|AUTO_APPROVE_SELECTED_LONG_READS|VALIDATE_FASTQ|VALIDATE_LONG_READ_MODELS' {
        publishDir = "${params.outdir}/reports"
    }
    withName: 'INSPECT_LONG_READ_MANIFEST|VALIDATE_FASTQ' {
        publishDir = "${params.outdir}/reports"
    }
    withName: 'ACQUIRE_LONG_READ_BAM' {
        publishDir = "${params.outdir}/bam"
    }
    withName: 'FASTQ_DL' {
        maxForks = 10
        publishDir = "${params.outdir}/fastq"
    }
    withName: 'BUILD_MINIMAP2_INDEX' {
        publishDir = "${params.outdir}/reference"
    }
    withName: 'MINIMAP2_ALIGN|SAMTOOLS_SORT_INDEX|ALIGNMENT_QC' {
        publishDir = "${params.outdir}/alignments"
    }
    withName: 'TAMA_COLLAPSE' {
        publishDir = "${params.outdir}/collapse"
    }
    withName: 'TAMA_MERGE|TAMA_MERGE_ACCESSION|TMERGE|TMERGE_ACCESSION' {
        publishDir = "${params.outdir}/merge"
    }
    withName: 'STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|TMERGE_COLLAPSE' {
        publishDir = "${params.outdir}/backend_models"
    }
    withName: 'CANONICALISE_COMBINED_MODELS|EXTRACT_COMBINED_TRANSCRIPTS' {
        publishDir = "${params.outdir}/combined"
    }
    withName: 'PREDICT_LONGEST_ATG_ORFS' {
        publishDir = "${params.outdir}/combined"
    }
    withName: 'REPORT_COMBINED_DIAMOND_MODELS' {
        publishDir = "${params.outdir}/qc/diamond"
    }
    // withName has higher precedence than the shared withLabel resource
    // defaults. This final catch-all makes the pipeline baseline unambiguous
    // for every process, including nested subworkflow processes.
    withName: '.*' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    // Keep this after the catch-all: the final matching selector must not
    // reintroduce retries/termination for a known TAMA tool failure.
    withName: 'TAMA_COLLAPSE|.*:TAMA_COLLAPSE' {
        errorStrategy = 'ignore'
        maxRetries = 0
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    local {
        process.executor = 'local'
        process.maxForks = 2
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
        wave.enabled = false
    }
    local_real {
        process.executor = 'local'
        process.maxForks = 2
        singularity.enabled = true
        docker.enabled = false
        conda.enabled = false
        wave.enabled = false
    }
    stub {
        process.executor = 'local'
        // Keep stub validation non-terminal too, matching production policy.
        process.errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        process.maxRetries = 5
        process.resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
        process {
            withName: '.*' {
                container = null
                conda = null
            }
        }
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
        wave.enabled = false
    }
}
