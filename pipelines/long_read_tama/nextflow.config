includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    manifest = null
    taxon_id = null
    tree = false
    discovery_probe = true
    target_sample_count = 8
    soft_download_budget = 250.0
    soft_raw_subread_budget = 1
    discovery_cache_dir = null
    approved_manifest = null
    auto_approve_safe = false
    metadata_json = null
    metadata_cache_dir = null
    fastq_cache_dir = null
    reference_fasta = null
    reference_fai = null
    minimap_index = null
    cohort_id = 'bos_indicus_long_read'
    model_backend = 'tama'
    backend_merge_mode = 'native'
    backend_failure_policy = 'fail_fast'
    outdir = './long_read_tama_results'
    minimap2_preset = 'splice:hq'
    secondary_mode = 'no'
    samtools_sort_memory = '2G'
    tama_container = null
    tama_cap_mode = 'no_cap'
    tama_end_mode = 'common_ends'
    tama_run_mode = 'low_mem'
    merge_tool = 'tama'
    stringtie2_merge_args = ''
    stringtie3_merge_args = ''
    stringtie_merge_scope = 'run_then_cohort'
    publish_native_intermediates = false
    tmerge_args = ''
    ccs_container = null
    ccs_command = 'ccs'
    ccs_args = ''
    ccs_expected_version = null
    // Split sorted BAMs by reference contig before TAMA by default. Use
    // --shard_mode none only for deliberately small inputs.
    shard_mode = 'contig'
    shard_contig_reads = 1000000
    skip_tama_shards = ''
    skip_model_shards = ''
    tama_memory_small = '128.GB'
    tama_memory_large = '256.GB'
    tama_memory_very_large = '512.GB'
    run_diamond_validation = false
    diamond_reference_db = null
    diamond_reference_proteins = null
    diamond_classification_type = 'long_read'
    ensembl_genes_container = 'dockerhub.ebi.ac.uk/ensembl_genebuild/ensembl-genes-containers/ensembl-genes'
    transcriptomic_data_command = 'python3 -m ensembl.genes.transcriptomic_data.get_transcriptomic_data'
    isoquant_mode = 'annotation_free'
    isoquant_scope = 'cohort'
    isoquant_data_type = 'pacbio_ccs'
    isoquant_genedb = null
    isoquant_complete_genedb = false
    isoquant_analysis = ['transcript_discovery']
    isoquant_large_output = ['read_info', 'read2transcripts']
    isoquant_read_group = ['none']
    isoquant_report_novel_unspliced = false
    isoquant_check_canonical = false
    isoquant_numba_disable_jit = false
    isoquant_args = ''
    isoquant_threads = null
    isoquant_high_memory = false
    isoquant_genedb_output = null
    flair_container = null
    flair_args = ''
    flair_threads = null
    bambu_container = null
    bambu_scope = 'cohort'
    bambu_install_biocmanager = true
    bambu_track_reads = true
    bambu_quantify = true
    bambu_r_lib = null
}

process {
    // Keep this pipeline moving: every process gets bounded retries and then
    // is ignored. Failures remain available in the Nextflow trace/report.
    errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
    maxRetries = 5
    maxErrors = 1
    // Label selectors from the shared resource config otherwise override the
    // generic process policy, so repeat the baseline at label scope.
    withLabel: 'process_light|process_low|process_medium|process_high|process_high_memory|process_long|process_single_long' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_light' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_low' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_medium' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_high' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_high_memory' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_long' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withLabel: 'process_single_long' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withName: 'FASTQ_DL|ACQUIRE_LONG_READ_BAM' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withName: 'STATS_FASTQ|PROBE_FASTQ|VALIDATE_FASTQ_RECORDS|AUDIT_FASTQ|STAGE_VALIDATED_FASTQ' {
        // A single accession may be corrupt or incompatible. Retry resource
        // failures, then skip that accession while other runs continue.
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    withName: 'TAMA_COLLAPSE' {
        // TAMA remains soft-fail only on the explicit legacy compatibility
        // path. Native mode treats every requested backend as required.
        time = 96.h
        errorStrategy = { params.backend_merge_mode == 'native' ? 'terminate' : 'ignore' }
        maxRetries = 0
    }
    withName: '.*:TAMA_COLLAPSE' {
        errorStrategy = { params.backend_merge_mode == 'native' ? 'terminate' : 'ignore' }
        maxRetries = 0
    }

    // Scale allocations on retry for other processes. All exhausted process
    // failures are non-terminal; process reports and status outputs preserve
    // the diagnostics needed to identify affected inputs.
    withName: 'DISCOVER_LONG_READ_DATA|INSPECT_LONG_READ_MANIFEST|AUTO_APPROVE_SELECTED_LONG_READS|VALIDATE_APPROVED_LONG_READ_MANIFEST|VALIDATE_LONG_READ_MANIFEST|RESOLVE_LONG_READ_METADATA|VALIDATE_FASTQ|VALIDATE_LONG_READ_MODELS' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'FASTQ_DL' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'BUILD_MINIMAP2_INDEX|EXTRACT_COMBINED_TRANSCRIPTS|PREDICT_LONGEST_ATG_ORFS|REPORT_COMBINED_DIAMOND_MODELS' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'MINIMAP2_ALIGN|SAMTOOLS_SORT_INDEX|ALIGNMENT_QC|SPLIT_BAM_BY_CONTIG|BAM_TO_ALIGNMENT_GTF' {
        memory = { 60.GB * task.attempt }
    }
    withName: 'RUN_PBCCS|BAM_TO_FASTQ|ACQUIRE_LONG_READ_BAM|TAMA_MERGE|TAMA_MERGE_ACCESSION|TMERGE|TMERGE_ACCESSION' {
        memory = { 64.GB * task.attempt }
    }
    withName: 'STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|BAM_TO_ALIGNMENT_GTF|TMERGE_COLLAPSE' {
        memory = { 64.GB * task.attempt }
    }
    withName: 'STRINGTIE2_MERGE|STRINGTIE3_MERGE|TMERGE_NATIVE_MERGE|GTF_TO_BED12' {
        memory = { 64.GB * task.attempt }
    }

    withName: 'DISCOVER_LONG_READ_DATA' {
        publishDir = "${params.outdir}/discovery"
    }
    withName: 'VALIDATE_LONG_READ_MANIFEST|VALIDATE_APPROVED_LONG_READ_MANIFEST|AUTO_APPROVE_SELECTED_LONG_READS|VALIDATE_FASTQ|VALIDATE_LONG_READ_MODELS' {
        publishDir = "${params.outdir}/reports"
    }
    withName: 'INSPECT_LONG_READ_MANIFEST|VALIDATE_FASTQ' {
        publishDir = "${params.outdir}/reports"
    }
    withName: 'ACQUIRE_LONG_READ_BAM' {
        publishDir = "${params.outdir}/bam"
    }
    withName: 'FASTQ_DL' {
        maxForks = 10
        publishDir = "${params.outdir}/fastq"
    }
    withName: 'BUILD_MINIMAP2_INDEX' {
        publishDir = "${params.outdir}/reference"
    }
    withName: 'MINIMAP2_ALIGN|SAMTOOLS_SORT_INDEX|ALIGNMENT_QC' {
        publishDir = "${params.outdir}/alignments"
    }
    withName: 'TAMA_COLLAPSE' {
        publishDir = "${params.outdir}/collapse"
    }
    withName: 'TAMA_MERGE|TAMA_MERGE_ACCESSION|TMERGE|TMERGE_ACCESSION' {
        publishDir = "${params.outdir}/merge"
    }
    withName: 'STRINGTIE2_MERGE|STRINGTIE3_MERGE|TMERGE_NATIVE_MERGE' {
        publishDir = [path: "${params.outdir}/native_models", enabled: params.publish_native_intermediates]
    }
    withName: 'ISOQUANT_ANNOTATION_FREE|ISOQUANT_REFERENCE_GUIDED' {
        cpus = params.isoquant_threads ?: 8
        memory = params.isoquant_high_memory ? 256.GB : 128.GB
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = "${params.outdir}/isoquant/native"
    }
    withName: 'FLAIR_JUNCTIONS' {
        memory = 64.GB
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = "${params.outdir}/flair/native"
    }
    withName: 'FLAIR_TRANSCRIPTOME|FLAIR_COMBINE' {
        cpus = params.flair_threads ?: 8
        memory = 128.GB
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = "${params.outdir}/flair/native"
    }
    withName: 'NORMALISE_ISOQUANT_OUTPUTS|AUDIT_ISOQUANT_OUTPUTS|ISOQUANT_TO_BED12' {
        errorStrategy = 'terminate'
        maxRetries = 0
    }
    withName: 'NORMALISE_ISOQUANT_OUTPUTS' {
        publishDir = "${params.outdir}/isoquant/products"
    }
    withName: 'AUDIT_ISOQUANT_OUTPUTS' {
        publishDir = "${params.outdir}/isoquant/reports"
    }
    withName: 'ISOQUANT_TO_BED12' {
        publishDir = "${params.outdir}/isoquant/comparison"
    }
    withName: 'FLAIR_TRANSCRIPTOME|FLAIR_COMBINE' {
        publishDir = "${params.outdir}/flair/native"
    }
    withName: 'BAMBU_DISCOVERY' {
        cpus = 8
        memory = 128.GB
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = "${params.outdir}/bambu/native"
    }
    withName: 'AUDIT_NATIVE_MODELS|AUDIT_NATIVE_COHORT_MODELS' {
        publishDir = "${params.outdir}/reports/native"
    }
    withName: 'AUDIT_BACKEND_SHARD_PLAN' {
        publishDir = "${params.outdir}/reports/shards"
    }
    withName: 'VALIDATE_BACKEND_SHARD_PLAN' {
        publishDir = "${params.outdir}/reports/shards"
    }
    withName: 'TAMA_MERGE_ACCESSION|TMERGE_MERGE_ACCESSION' {
        publishDir = "${params.outdir}/backend_models"
    }
    withName: 'STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|TMERGE_COLLAPSE' {
        publishDir = "${params.outdir}/backend_models"
    }
    withName: 'CANONICALISE_COMBINED_MODELS|EXTRACT_COMBINED_TRANSCRIPTS' {
        publishDir = "${params.outdir}/final_models"
    }
    withName: 'PREDICT_LONGEST_ATG_ORFS' {
        publishDir = "${params.outdir}/combined"
    }
    withName: 'REPORT_COMBINED_DIAMOND_MODELS' {
        publishDir = "${params.outdir}/qc/diamond"
    }
    // withName has higher precedence than the shared withLabel resource
    // defaults. This final catch-all makes the pipeline baseline unambiguous
    // for every process, including nested subworkflow processes.
    withName: '.*' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }
    // Keep this after the catch-all: the final matching selector must not
    // reintroduce retries/termination for a known TAMA tool failure.
    withName: 'TAMA_COLLAPSE|.*:TAMA_COLLAPSE' {
        errorStrategy = { params.backend_failure_policy == 'continue' ? 'ignore' : (params.backend_merge_mode == 'native' ? 'terminate' : 'ignore') }
        maxRetries = 0
    }
    withName: 'TAMA_MERGE|TAMA_MERGE_ACCESSION|TMERGE|TMERGE_MERGE_ACCESSION|STRINGTIE2_MERGE|STRINGTIE3_MERGE|TMERGE_NATIVE_MERGE' {
        errorStrategy = { params.backend_failure_policy == 'continue' ? 'ignore' : 'terminate' }
        maxRetries = 0
    }
    withName: 'STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|TMERGE_COLLAPSE|BAM_TO_ALIGNMENT_GTF|.*:STRINGTIE2_COLLAPSE|.*:STRINGTIE3_COLLAPSE|.*:TMERGE_COLLAPSE|.*:BAM_TO_ALIGNMENT_GTF' {
        errorStrategy = { params.backend_failure_policy == 'continue' ? 'ignore' : 'terminate' }
        maxRetries = 0
    }
    withName: 'ISOQUANT_ANNOTATION_FREE|ISOQUANT_REFERENCE_GUIDED|NORMALISE_ISOQUANT_OUTPUTS|AUDIT_ISOQUANT_OUTPUTS|ISOQUANT_TO_BED12|.*:ISOQUANT_ANNOTATION_FREE|.*:ISOQUANT_REFERENCE_GUIDED|.*:NORMALISE_ISOQUANT_OUTPUTS|.*:AUDIT_ISOQUANT_OUTPUTS|.*:ISOQUANT_TO_BED12' {
        errorStrategy = { params.backend_failure_policy == 'continue' ? 'ignore' : 'terminate' }
        maxRetries = 0
    }
    withName: 'FLAIR_JUNCTIONS|FLAIR_TRANSCRIPTOME|FLAIR_COMBINE|BAMBU_DISCOVERY|.*:FLAIR_JUNCTIONS|.*:FLAIR_TRANSCRIPTOME|.*:FLAIR_COMBINE|.*:BAMBU_DISCOVERY|COMPARE_CANDIDATE_MODELS|COMPARE_ACCESSION_CANDIDATE_MODELS' {
        errorStrategy = { params.backend_failure_policy == 'continue' ? 'ignore' : 'terminate' }
        maxRetries = 0
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    local {
        process.executor = 'local'
        process.maxForks = 2
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
        wave.enabled = false
    }
    local_real {
        process.executor = 'local'
        process.maxForks = 2
        // Keep the real local smoke profile usable on developer machines;
        // production/HPC profiles retain the larger backend allocations above.
        process {
            withName: 'BUILD_MINIMAP2_INDEX|MINIMAP2_ALIGN|SAMTOOLS_SORT_INDEX|ALIGNMENT_QC|SPLIT_BAM_BY_CONTIG|BAM_TO_ALIGNMENT_GTF|GTF_TO_BED12|VALIDATE_LONG_READ_MODELS' {
                cpus = 2
                memory = 8.GB
                time = 1.h
            }
            withName: 'TAMA_COLLAPSE|TAMA_MERGE|TAMA_MERGE_ACCESSION|STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|TMERGE_COLLAPSE|TMERGE_NATIVE_MERGE|STRINGTIE2_MERGE|STRINGTIE3_MERGE' {
                cpus = 2
                memory = 8.GB
                time = 2.h
            }
            withName: 'FLAIR_JUNCTIONS' {
                cpus = 2
                memory = 8.GB
                time = 1.h
            }
            withName: 'FLAIR_TRANSCRIPTOME|FLAIR_COMBINE' {
                cpus = 2
                memory = 16.GB
                time = 2.h
            }
            withName: 'ISOQUANT_ANNOTATION_FREE|ISOQUANT_REFERENCE_GUIDED' {
                cpus = 2
                memory = 16.GB
                time = 2.h
            }
            withName: 'BAMBU_DISCOVERY' {
                cpus = 2
                memory = 16.GB
                time = 2.h
            }
            withName: 'FASTQ_DL|VALIDATE_FASTQ_RECORDS|PROBE_FASTQ|STATS_FASTQ|AUDIT_FASTQ|STAGE_VALIDATED_FASTQ|VALIDATE_APPROVED_LONG_READ_MANIFEST' {
                cpus = 1
                memory = 4.GB
                time = 1.h
            }
        }
        singularity.enabled = true
        docker.enabled = false
        conda.enabled = false
        wave.enabled = false
    }
    stub {
        process.executor = 'local'
        // Keep stub validation non-terminal too, matching production policy.
        process.errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        process.maxRetries = 5
        process.resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
        process {
            withName: '.*' {
                container = null
                conda = null
            }
        }
        singularity.enabled = false
        docker.enabled = false
        conda.enabled = false
        wave.enabled = false
    }
}
