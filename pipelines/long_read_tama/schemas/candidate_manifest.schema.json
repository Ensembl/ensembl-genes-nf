{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Historical long-read candidate manifest",
  "type": "object",
  "required": ["run_accession", "tissue", "description", "url", "md5", "platform"],
  "properties": {
    "run_accession": {"type": "string", "pattern": "^(SRR|ERR|DRR)[0-9]+$"},
    "tissue": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "url": {"type": "string", "pattern": "^(https?|ftp)://"},
    "md5": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
    "platform": {"type": "string", "minLength": 1}
  }
}
