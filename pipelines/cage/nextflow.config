includeConfig '../../nextflow.config'

nextflow.enable.strict = true

plugins {
    id 'nf-schema@2.2.0'
}

params {
    sample_manifest = null
    reference_manifest = null
    protocol_profiles = "${projectDir}/assets/protocol_profiles.tsv"
    reference_cache = "${projectDir}/.cage-reference-cache"
    orthology_manifest = null
    run_cross_species = false
    outdir = './results'
}

process {
    // Retry only likely memory/infrastructure failures. Deterministic input and
    // tool errors must fail immediately rather than being retried blindly.
    withLabel: cage_python {
        container = 'quay.io/biocontainers/python:3.12.12'
        cpus = 1
        memory = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
        time = '2.h'
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withName: ACQUIRE_READS { container = 'quay.io/biocontainers/fastq-dl:4.0.1--pyhdfd78af_0' }
    withLabel: cage_trim {
        container = 'quay.io/biocontainers/cutadapt:5.2--py312hfabe715_2'
        cpus = 2
        memory = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 16.GB }
        time = '4.h'
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withLabel: cage_star {
        container = 'quay.io/biocontainers/star:2.7.11b--h5814d7d_9'
        cpus = 8
        memory = { task.attempt == 1 ? 32.GB : task.attempt == 2 ? 64.GB : 128.GB }
        time = '12.h'
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withLabel: cage_samtools {
        container = 'quay.io/biocontainers/samtools:1.25--h9dcdb79_0'
        cpus = 2
        memory = { task.attempt == 1 ? 8.GB : task.attempt == 2 ? 16.GB : 32.GB }
        time = '4.h'
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withLabel: cage_r {
        container = 'quay.io/biocontainers/bioconductor-cagefightr:1.30.0--r45hdfd78af_0'
        cpus = 4
        memory = { task.attempt == 1 ? 16.GB : task.attempt == 2 ? 32.GB : 64.GB }
        time = '12.h'
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withName: ACQUIRE_READS { errorStrategy = 'retry'; maxRetries = 2; maxForks = 4 }
}

profiles {
    test {
        process.executor = 'local'
        params.sample_manifest = "${projectDir}/assets/test_samples.tsv"
        params.reference_manifest = "${projectDir}/assets/test_references.tsv"
        params.reference_cache = "${projectDir}/results/test/reference_cache"
        params.outdir = './results/test'
        process.container = null
        process {
            withLabel: cage_python { cpus = 1; memory = '1.GB'; time = '1.h'; container = null; errorStrategy = 'terminate' }
            withLabel: cage_trim { cpus = 1; memory = '1.GB'; time = '1.h'; container = null; errorStrategy = 'terminate' }
            withLabel: cage_star { cpus = 1; memory = '2.GB'; time = '1.h'; container = null; errorStrategy = 'terminate' }
            withLabel: cage_samtools { cpus = 1; memory = '1.GB'; time = '1.h'; container = null; errorStrategy = 'terminate' }
            withLabel: cage_r { cpus = 1; memory = '1.GB'; time = '1.h'; container = null; errorStrategy = 'terminate' }
            withName: ACQUIRE_READS { container = null }
        }
        singularity { enabled = false }
        docker { enabled = false }
    }
    slurm { process.executor = 'slurm' }
    local { process.executor = 'local'; process.maxForks = 2 }
}
