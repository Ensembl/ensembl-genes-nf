includeConfig '../../nextflow.config'

nextflow.enable.strict = true

plugins {
    id 'nf-schema@2.2.0'
}

params {
    sample_manifest = null
    reference_manifest = null
    protocol_profiles = "${projectDir}/assets/protocol_profiles.tsv"
    reference_cache = "${projectDir}/.cage-reference-cache"
    orthology_manifest = null
    run_cross_species = false
    outdir = './results'
}

process {
    withLabel: cage_python { container = 'quay.io/biocontainers/python:3.12.12'; cpus = 1; memory = '2.GB'; time = '2.h' }
    withName: ACQUIRE_READS { container = 'quay.io/biocontainers/fastq-dl:4.0.1--pyhdfd78af_0' }
    withLabel: cage_trim { container = 'quay.io/biocontainers/cutadapt:5.2--py312hfabe715_2'; cpus = 2; memory = '4.GB'; time = '4.h' }
    withLabel: cage_star { container = 'quay.io/biocontainers/star:2.7.11b--h5814d7d_9'; cpus = 8; memory = '32.GB'; time = '12.h' }
    withLabel: cage_samtools { container = 'quay.io/biocontainers/samtools:1.25--h9dcdb79_0'; cpus = 2; memory = '8.GB'; time = '4.h' }
    withLabel: cage_r { container = 'quay.io/biocontainers/bioconductor-cagefightr:1.30.0--r45hdfd78af_0'; cpus = 4; memory = '16.GB'; time = '12.h' }
    withName: ACQUIRE_READS { errorStrategy = 'retry'; maxRetries = 2; maxForks = 4 }
}

profiles {
    test {
        process.executor = 'local'
        params.sample_manifest = "${projectDir}/assets/test_samples.tsv"
        params.reference_manifest = "${projectDir}/assets/test_references.tsv"
        params.reference_cache = "${projectDir}/results/test/reference_cache"
        params.outdir = './results/test'
        process {
            withLabel: cage_python { cpus = 1; memory = '1.GB'; time = '1.h' }
            withLabel: cage_trim { cpus = 1; memory = '1.GB'; time = '1.h' }
            withLabel: cage_star { cpus = 1; memory = '2.GB'; time = '1.h' }
            withLabel: cage_samtools { cpus = 1; memory = '1.GB'; time = '1.h' }
            withLabel: cage_r { cpus = 1; memory = '1.GB'; time = '1.h' }
        }
    }
    slurm { process.executor = 'slurm' }
    local { process.executor = 'local'; process.maxForks = 2 }
}
