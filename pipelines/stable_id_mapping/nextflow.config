params {
    samplesheet        = null
    db_name            = null

    mode               = 'auto'

    target_fasta       = null
    target_gff         = null
    ref_fasta          = null
    ref_gff            = null
    mapping_session_id = null
	
    rules_config      = "${projectDir}/assets/stable_id_mapping_rules.json"
    output_dir        = "results"

    lifton_threads    	 = 8
    lifton_executable 	 = "lifton"
	lifton_feature_types = "gene,ncRNA_gene,pseudogene"

	include_translations = true

	audit_limit = 20

    dry_run_sql       		   = false  // NOTE: executable/COMMIT SQL by default — confirm this is intended for batch runs
    replace_events_for_session = false

    batch_size        = 500
}

env {
	PYTHONPATH = "${projectDir}/bin"
}

trace {
    overwrite = true
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            time     = '2h'
            memory   = '4 GB'
            cpus     = 1

			withName: 'RESOLVE_SPECIES_INPUTS' {
                time   = '30m'
                memory = '2 GB'
				queue  = 'datamover'
			}

			withName: 'STAGE_SPECIES_INPUTS' {
    			time   = '2h'
    			memory = '8 GB'
    			queue  = 'datamover'
			}

			withName: 'LIFTON_PROJECTION' {
				time   = '8h'
				memory = '100 GB'
				cpus   = 8
            }

			withName: 'STRUCTURAL_MATCHING' {
    			time   = '2h'
    			memory = '16 GB'
			}

			withName: 'STABLE_ID_DECISIONS' {
    			time   = '2h'
    			memory = '6 GB'
			}

			withName: 'RENDER_STABLE_ID_SQL' {
    			time   = '30m'
    			memory = '4 GB'
			}

			withName: 'AUDIT_RUN' {
    			time   = '1h'
    			memory = '8 GB'
			}
        }
    }
}
