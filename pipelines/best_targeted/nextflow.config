/*
========================================================================================
    BEST_TARGETED PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    genome_fasta   = null   // SOFTMASKED genome FASTA
    cdna_fasta     = null   // optional: cDNA / mRNA FASTA (species-specific)
    protein_fasta  = null   // optional: protein FASTA (UniProt/RefSeq self)
    outdir         = null

    // Sequence batching
    cdna_batch_size    = 200    // sequences per exonerate batch (cDNA)
    protein_batch_size = 50     // sequences per exonerate batch (protein)

    // Per-batch filtering (applied before best-pick)
    exonerate_min_coverage = 50   // matches best_targetted_min_coverage in Perl
    exonerate_min_pid      = 50   // matches best_targetted_min_identity in Perl

    // Final best-targeted selection
    best_targeted_min_coverage = 50
    best_targeted_min_pid      = 50
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'ALIGN_AND_FILTER:EXONERATE_CDNA' {
        cpus       = 4
        memory     = { 8.GB * task.attempt }
        time       = '8.h'
        maxRetries = 1
    }
    withName: 'ALIGN_AND_FILTER:EXONERATE_PROTEIN' {
        cpus       = 4
        memory     = { 8.GB * task.attempt }
        time       = '8.h'
        maxRetries = 1
    }
    withName: 'ALIGN_AND_FILTER:FILTER_EXONERATE' {
        memory = '1.GB'
        time   = '30.m'
    }
    withName: 'SELECT_BEST_TARGETED' {
        memory = '4.GB'
        time   = '1.h'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
