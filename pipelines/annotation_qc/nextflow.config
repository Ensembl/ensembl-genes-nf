includeConfig '../../nextflow.config'

nextflow.enable.strict = true

env {
	PYTHONPATH = "${projectDir}/bin"
}

trace {
	overwrite = true
}

params {
    input_manifest = "${projectDir}/inputs.tsv"
    outdir         = "${projectDir}/results"

    feature_type        = 'gene'
    canonical_only      = false
    biotypes            = []
    exclude_biotypes    = []

    min_intron_length   = 20
    min_exon_length     = 3
    gc_bin_size         = 10
}

profiles {
    test {
        process.executor = 'local'
        params.input_manifest = "${projectDir}/testdata/inputs.tsv"
        params.outdir = "${projectDir}/results/test"
    }

    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = false
    }

    local {
        process.executor = 'local'
    }
}

process {
    withName: PARSE_ANNOTATION {
        label = 'process_light'
    }

    withName: FEATURE_METRICS {
        label = 'process_low'
    }

    withName: FASTA_METRICS {
        label = 'process_long'
    }

    withName: GENOME_METRICS {
        label = 'process_low'
    }
}