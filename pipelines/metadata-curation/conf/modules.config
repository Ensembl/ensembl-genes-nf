/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When to run the module.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: EXTRACT_SRA_METADATA {
        ext.args = '--max-results 1000'
        publishDir = [
            path: { "${params.outdir}/sra" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: EXTRACT_GEO_METADATA {
        ext.args = '--max-results 1000'
        publishDir = [
            path: { "${params.outdir}/geo" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: EXTRACT_PMC_CONTENT {
        ext.args = '--max-results 100'
        publishDir = [
            path: { "${params.outdir}/pmc" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: MAP_ONTOLOGY_TERMS {
        publishDir = [
            path: { "${params.outdir}/ontology" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: EXTRACT_STUDY_CONTEXT {
        publishDir = [
            path: { "${params.outdir}/context" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: PROCESS_SAMPLE_METADATA {
        publishDir = [
            path: { "${params.outdir}/processed" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: DETECT_BIOGROUPS {
        publishDir = [
            path: { "${params.outdir}/biogroups" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: VALIDATE_QUALITY {
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }




}