// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Require syntax supported by current Nextflow releases.
nextflow.enable.strict = true

plugins {
    id 'nf-schema@2.2.0'
}

params {
    outdir                    = './results'
    input_csv                 = null
    mode                      = null
    database                  = 'Pfam'
    data_file_path            = null
    diamond_reference_proteins = null
    diamond_reference_db       = null
    pairwise_csv              = null
    pairwise_cache_dir        = "${params.outdir}/cache/pairwise_annotation"
    pairwise_reference_annotation = null
    pairwise_reference_format = 'auto'
    pairwise_locus_min_overlap_bp = 10
    pairwise_locus_min_reciprocal_overlap = 0.10
    pairwise_end_threshold    = 50
    pairwise_contig_normalization = 'none'
    pairwise_multi_mapping_min_overlap = 0.1
    run_pairwise_legacy_metrics = true
    run_pairwise_transcript_concordance = true
    run_pairwise_coding_integrity = true
    run_pairwise_gene_presence = true
    run_pairwise_multi_mapping = true
    run_pairwise_gff_feature_metrics = true
    run_pairwise_transcript_counts = true
    run_pairwise_gffcompare = false
}

process {

    withLabel: qc_parser {
        // Use :latest while the annotation-QC container is under development;
        // pin this to the matching SHA when the pipeline is versioned.
        container = 'dockerhub.ebi.ac.uk/ensembl_genebuild/ensembl-genes-containers/ensembl-genes-qc-dev:latest'
        cpus = 1
        memory = '4.GB'
        time = '2.h'
    }

    withName: AGAT_RUN_STATS {
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = 8
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: AGAT_PARSE {
        maxForks = 8
    }

    withName: INTERPRO_RUN {
        cpus = 16
        memory = { 16.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = 8
        errorStrategy = 'retry'
        maxRetries = 0
    }

    // Large long-read BED12 comparisons can contain millions of unassigned
    // models. The locus sweep keeps the work bounded by interval candidates,
    // but the canonical model tables still need more than process_low memory.
    withName: ASSIGN_TRANSCRIPT_LOCI {
        cpus = 2
        memory = { 32.GB * task.attempt }
        time = '12.h'
    }

    withName: STAGE_TRANSCRIPT_INPUTS {
        cpus = 1
        memory = '4.GB'
        time = '4.h'
    }

    withName: NORMALISE_TRANSCRIPT_PAIR {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = { 8.h * task.attempt }
    }

    withName: COMPARE_TRANSCRIPT_FEATURES {
        cpus = 2
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    // Locus-audit materialises both canonical model tables in memory. Start
    // above the generic process_light allocation and retry scheduler/resource
    // kills with progressively larger allocations. If all fallback attempts
    // are killed, omit this optional audit so the pairwise run can continue.
    withName: AUDIT_LOCUS_ASSIGNMENT {
        cpus = 2
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
        errorStrategy = {
            task.exitStatus in [137, 140, 143]
                ? (task.attempt < 3 ? 'retry' : 'ignore')
                : 'terminate'
        }
        maxRetries = 2
    }

    // Benchmark export materialises both model tables and structural joins.
    // Retry scheduler/resource kills with progressively larger allocations;
    // ordinary script failures still terminate immediately.
    withName: EXPORT_BENCHMARK_PAIR {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }

    withName: AGGREGATE_PAIRWISE_BENCHMARK {
        cpus = 2
        memory = { 16.GB * task.attempt }
        time = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }

    withLabel: process_light {
        container = 'https://depot.galaxyproject.org/singularity/pyranges:0.1.2--pyhdfd78af_1'
    }

}

profiles {
    slurm {
        process {
            executor = 'slurm'
        }

        singularity {
            enabled = true
            autoMounts = false
        }
    }

    // Local execution with Singularity (for testing/development)
    local {
        process {
            executor = 'local'
            maxForks = 2
            stageInMode = 'copy'

            withName: 'INTERPRO_RUN' {
                cpus = 1
                memory = '4.GB'
                time = '1.h'
            }

            withName: 'DIAMOND_BLASTP' {
                cpus = 1
                memory = '4.GB'
                time = '1.h'
            }
        }
    }
}
