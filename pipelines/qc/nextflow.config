// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    outdir             = './results'
    gff_csv            = null   // path to the CSV of gffs
    feature_levels     = null
    ensembl_genes_repo = null  // path to local checkout of ensembl-genes
    agat_parser        = null  // optional explicit path to parse_agat.py; otherwise derived from ensembl_genes_repo
    run_agat_metrics   = true

    pairwise_csv       = null
    pairwise_cache_dir = "${params.outdir}/cache/pairwise_annotation"
    pairwise_ensg_lookup = null
    pairwise_contig_normalization = 'none'
    pairwise_multi_mapping_min_overlap = 0.1

    run_pairwise_annotation_comparison = false
    run_pairwise_transcript_concordance = true
    run_pairwise_coding_integrity = true
    run_pairwise_gene_presence = true
    run_pairwise_multi_mapping = true
    run_pairwise_gff_feature_metrics = true
    run_pairwise_transcript_counts = true
    run_pairwise_gffcompare = false
}

process {

    withName: AGAT_RUN_STATS {
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = 8
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: AGAT_PARSE {
        maxForks = 8
    }

    withName: STAGE_ANNOTATION_PAIR {
        maxForks = 8
    }

    withName: PAIR_GENES {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = { 8.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 2
        maxForks = 4
    }

    withName: PAIRWISE_TRANSCRIPT_CONCORDANCE {
        maxForks = 8
    }

    withName: PAIRWISE_CODING_INTEGRITY {
        maxForks = 8
    }

    withName: PAIRWISE_GENE_PRESENCE {
        maxForks = 8
    }

    withName: PAIRWISE_MULTI_MAPPING {
        maxForks = 8
    }

    withName: PAIRWISE_GFF_FEATURE_METRICS {
        maxForks = 8
    }

    withName: PAIRWISE_GFF_TO_GTF {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = 8
    }
}
