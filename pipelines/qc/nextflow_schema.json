{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annotation QC pipeline parameters",
  "description": "Run one or more QC analyses from a mode-specific annotation manifest.",
  "type": "object",
  "properties": {
    "input_csv": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "pattern": "^\\S+\\.csv$",
      "description": "Mode-specific CSV annotation manifest; see the pipeline README."
    },
    "mode": {
      "type": "string",
      "enum": ["agat", "interproscan", "diamond", "combined"],
      "description": "QC analysis to run. combined runs all available analyses."
    },
    "database": {
      "type": "string",
      "enum": [
        "TIGRFAM", "SFLD", "SUPERFAMILY", "PANTHER", "Gene3D", "Hamap",
        "ProSiteProfiles", "Coils", "SMART", "CDD", "PRINTS", "PIRSR",
        "ProSitePatterns", "AntiFam", "Pfam", "MobiDBLite", "PIRSF"
      ],
      "default": "Pfam",
      "description": "InterProScan application database."
    },
    "data_file_path": {
      "type": "string",
      "format": "directory-path",
      "exists": true,
      "description": "Local InterProScan data directory."
    },
    "diamond_reference_proteins": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Reference protein FASTA used to build the Diamond database."
    },
    "diamond_reference_db": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Existing Diamond database file. When supplied, the reference protein FASTA is not used."
    },
    "add_metrics_to_registry": {
      "type": "boolean",
      "default": false,
      "description": "Write final AGAT metrics to the assembly registry."
    },
    "registry_host": {
      "type": "string",
      "description": "Registry MySQL host. Required when registry loading is enabled."
    },
    "registry_port": {
      "type": "integer",
      "default": 4527,
      "description": "Registry MySQL port."
    },
    "registry_user": {
      "type": "string",
      "description": "Registry MySQL user. Required when registry loading is enabled."
    },
    "registry_password": {
      "type": "string",
      "description": "Registry MySQL password. Required when registry loading is enabled."
    },
    "registry_db": {
      "type": "string",
      "default": "gb_assembly_metadata",
      "description": "Registry MySQL database name."
    },
    "outdir": {
      "type": "string",
      "default": "./results",
      "description": "Output directory."
    },
    "tracedir": {
      "type": "string",
      "description": "Directory for Nextflow execution reports and trace files."
    }
  },
  "required": ["input_csv", "mode"],
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"enum": ["interproscan", "combined"]}},
        "required": ["mode"]
      },
      "then": {"required": ["data_file_path"]}
    },
    {
      "if": {
        "properties": {"mode": {"enum": ["diamond", "combined"]}},
        "required": ["mode"]
      },
      "then": {
        "oneOf": [
          {"required": ["diamond_reference_db"]},
          {"required": ["diamond_reference_proteins"]}
        ]
      }
    },
    {
      "if": {
        "properties": {"add_metrics_to_registry": {"const": true}},
        "required": ["add_metrics_to_registry"]
      },
      "then": {
        "required": ["registry_host", "registry_user", "registry_password"]
      }
    }
  ]
}
