// ENA submission pipeline-specific configuration

manifest {
    name        = 'ENA Submission Pipeline'
    description = 'Uploads analysis files to ENA and submits ANALYSIS XML/REST receipts.'
    version     = '0.1.0'
}

params {
    // Required: a TSV/CSV with columns described in README
    manifest        = null
    // ENA Webin username. Store the password with `nextflow secrets set`
    // rather than passing it as a pipeline parameter.
    webin_user      = null
    // Mode: prod or test (uses wwwdev endpoints)
    mode            = 'test'
    // Limit concurrent uploads to avoid overloading ENA
    upload_parallelism = 2
    // Optional remote subdirectory inside the Webin drop-box
    remote_dir      = ''
    // Optional umbrella study accession/alias. Recorded as analysis metadata for now;
    // project cross-link XML is pending ENA umbrella study setup/validation.
    umbrella_study  = ''
    project_description = null
    // FTP host (override if ENA updates domain)
    webin_ftp_host  = 'webin2.ebi.ac.uk'
    // Webin REST v2 base URL — derived from mode if not set explicitly
    webin_base      = null
    // Optional hold-until date (YYYY-MM-DD); if null, immediate add
    hold_until      = null
    // Optional BAM-to-CRAM conversion before checksumming and upload
    convert_to_cram = false
    // Reheader BAMs to the supplied INSDC reference before checksumming/upload.
    reheader_bams = true
    // Optional overrides for manifests created before automatic reference discovery.
    reference_fasta = null
    reference_assembly_report = null
    // Polling: 30 × 20s = 10 min max (matches ENA async timeout)
    poll_interval    = 20
    poll_max_attempts = 30
}

process {
    withName: 'ENA_FTP_UPLOAD' { maxForks = params.upload_parallelism }

    withLabel: 'process_light' {
        cpus = 1
        memory = { 3.GB * task.attempt }
        time = { 1.h * task.attempt }
        maxForks = 10
        afterScript = { "sleep 60" }
    }

    withLabel: 'process_single_long' {
        cpus = 1
        memory = { 3.GB * task.attempt }
        time = { 4.h * task.attempt }
        afterScript = { "sleep 60" }
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }
    singularity {
        docker.enabled      = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = '--no-home'
    }
}
