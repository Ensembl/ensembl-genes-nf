{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ensembl/ensembl-genes-nf/long-read-retrospective",
  "title": "Long-read retrospective evidence collection",
  "type": "object",
  "properties": {
    "retrospective_manifest": {"type": "string", "format": "file-path", "exists": true},
    "reference_fasta": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "reference_metadata": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "tracedir": {"type": "string"},
    "mode": {"type": "string", "enum": ["fastq", "bam", "approved_manifest"]},
    "manifest": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "approved_manifest": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "reference_fai": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "cohort_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "outdir": {"type": "string"},
    "evidence_mode": {"type": "string", "enum": ["enabled"]},
    "evidence_min_mapq": {"type": "integer", "minimum": 0},
    "ccs_mode": {"type": "string", "enum": ["disabled", "pbccs"], "default": "disabled"},
    "preparation_stages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["discover", "resolve_metadata", "acquire", "bam_to_fastq"]}},
    "discovery_query": {"type": ["string", "null"]},
    "minimap2_preset": {"type": "string", "enum": ["splice:hq", "splice", "map-ont", "map-pb"]},
    "secondary_mode": {"type": "boolean"},
    "model_backends": {"type": "array", "items": {"type": "string", "enum": ["tama", "stringtie2", "stringtie3", "tmerge", "isoquant", "flair", "bambu", "transgram", "all"]}},
    "backend_scopes": {"type": "array", "items": {"type": "string", "enum": ["run", "cohort"]}},
    "shard_mode": {"type": "string", "enum": ["contig", "none"]},
    "shard_contig_reads": {"type": "integer", "minimum": 0},
    "shard_very_large_reads": {"type": "integer", "minimum": 1},
    "shard_max_concurrent": {"type": ["integer", "null"], "minimum": 1},
    "publish_native_intermediates": {"type": "boolean"},
    "alignment_qc": {"type": "boolean"},
    "orf_mode": {"type": "string", "enum": ["disabled", "enabled"]},
    "diamond_mode": {"type": "string", "enum": ["disabled", "enabled"]},
    "tama_cap_mode": {"type": "string", "enum": ["no_cap", "capped"]},
    "tama_end_mode": {"type": "string", "enum": ["common_ends", "longest_ends"]},
    "tama_run_mode": {"type": "string", "enum": ["low_mem", "original"]},
    "stringtie2_merge_args": {"type": "string"},
    "stringtie3_merge_args": {"type": "string"},
    "tmerge_args": {"type": "string"},
    "isoquant_mode": {"type": "string", "enum": ["annotation_free", "reference_guided"]},
    "isoquant_scope": {"type": "string", "enum": ["run", "cohort", "both"]},
    "isoquant_data_type": {"type": "string", "enum": ["pacbio_ccs", "nanopore", "assembly"]},
    "isoquant_genedb": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "isoquant_analysis": {"type": "array", "items": {"type": "string"}},
    "isoquant_high_memory": {"type": "boolean"},
    "isoquant_args": {"type": "string"},
    "isoquant_large_output": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["read_info", "read_assignments", "corrected_bed", "read2transcripts", "allinfo", "tagged_bam", "deduplicated_bam", "none"]}},
    "flair_args": {"type": "string"},
    "flair_threads": {"type": ["integer", "null"], "minimum": 1},
    "bambu_scope": {"type": "string", "enum": ["run", "cohort", "both"]},
    "bambu_track_reads": {"type": "boolean"},
    "bambu_quantify": {"type": "boolean"},
    "transgram_annotation": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "transgram_data_type": {"type": "string", "enum": ["auto", "alpha", "beta"]},
    "transgram_args": {"type": "string"},
    "transgram_executable": {"type": "string"},
    "diamond_database": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "diamond_reference_proteins": {"type": ["string", "null"], "format": "file-path", "exists": true},
    "tool_containers": {
      "type": "object",
      "required": ["minimap2", "samtools", "tama", "tmerge", "pbccs", "stringtie2", "stringtie3", "isoquant", "flair", "bambu", "transgram", "diamond", "python_helper"],
      "properties": {
        "minimap2": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "samtools": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "tama": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "tmerge": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "pbccs": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "stringtie2": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "stringtie3": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "isoquant": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "flair": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "bambu": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "transgram": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$|^https://downloads\\.sourceforge\\.net/project/transgram/Docker/trans_gram-[0-9]{8}\\.sif$"},
        "diamond": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"},
        "python_helper": {"type": "string", "pattern": "^(quay\\.io|docker\\.io)/.+@sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "use_containers": {"type": "boolean"}
  },
  "required": ["retrospective_manifest", "cohort_id", "outdir"],
  "allOf": [{"anyOf": [{"required": ["reference_fasta"]}, {"required": ["reference_metadata"]}]}]
}
