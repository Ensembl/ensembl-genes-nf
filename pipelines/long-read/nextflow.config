includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    outdir = './long-read-results'
    tracedir = "${params.outdir}/pipeline_info"
    mode = 'fastq'
    manifest = null
    approved_manifest = null
    retrospective_manifest = null
    reference_fasta = null
    reference_metadata = null
    reference_fai = null
    cohort_id = 'long_read_cohort'
    fastq_cache_dir = null
    minimap2_preset = 'splice:hq'
    secondary_mode = false
    model_backends = ['tama']
    backend_scopes = ['run', 'cohort']
    shard_mode = 'contig'
    shard_contig_reads = 1000000
    shard_very_large_reads = 5000000
    // Contig fan-out is deliberately bounded for Slurm. Override explicitly
    // for a controlled benchmark or a site with a different fair-share limit.
    shard_max_concurrent = 4
    tama_memory_small = '128.GB'
    tama_memory_large = '256.GB'
    tama_memory_very_large = '512.GB'
    tama_max_retries = 5
    // Retry infrastructure/resource failures with progressively larger allocations.
    // Logical tool and input failures still terminate immediately.
    resource_retry_max = 2
    publish_native_intermediates = false
    alignment_qc = true
    ccs_mode = 'disabled'
    preparation_stages = []
    discovery_query = null
    evidence_mode = 'disabled'
    orf_mode = 'disabled'
    diamond_mode = 'disabled'
    tama_cap_mode = 'no_cap'
    tama_end_mode = 'common_ends'
    tama_run_mode = 'low_mem'
    stringtie2_merge_args = ''
    stringtie3_merge_args = ''
    tmerge_args = ''
    isoquant_mode = 'annotation_free'
    isoquant_scope = 'both'
    isoquant_data_type = 'pacbio_ccs'
    isoquant_genedb = null
    isoquant_analysis = ['transcript_discovery']
    isoquant_high_memory = false
    isoquant_args = ''
    isoquant_large_output = []
    flair_args = ''
    flair_threads = null
    bambu_scope = 'both'
    bambu_track_reads = true
    bambu_quantify = true
    diamond_database = null
    diamond_reference_proteins = null
    tool_containers = [
        minimap2: 'quay.io/biocontainers/minimap2@sha256:0c397895db3b494baa4f78de7110d516a1a57707d9c7df456634220bffd965ba',
        samtools: 'quay.io/biocontainers/samtools@sha256:783c6646029a306ec5e4162009dc1a20d8f6c528f7c380e5b4affbf12d9112e5',
        tama: 'docker.io/sguizard/tama@sha256:66a05355155f5ecef2f585736e7fe3d9d9ad38b566f1179437828ad2d7bfd123',
        tmerge: 'docker.io/library/perl@sha256:587c0c65838dca2fa760e0a0ab169f7260894f208e68f38535ca644f397470c7',
        pbccs: 'quay.io/biocontainers/pbccs@sha256:6876708af8f1bd3af45740d86fa2f0479bea48e72bc97118240cb9f4fbd5e13b',
        stringtie2: 'quay.io/biocontainers/stringtie@sha256:84207eb013dbcff90928d8ddc75902580d3885ce8edaa36b8fab7665a3dc2e3c',
        stringtie3: 'quay.io/biocontainers/stringtie@sha256:1e2d08591607f70ee10b830a5fd17eaa3c1c34d25ca28cb224a73658053a1f31',
        isoquant: 'quay.io/biocontainers/isoquant@sha256:5b922f8211cfe6f438b814f95d83f6d141cc5ad4fc0796c3667784f102c57454',
        flair: 'quay.io/biocontainers/flair@sha256:a39894c1507c68241fba62ddbe1a931d5a6bfaacbcb6be24631d46b60e67ce84',
        bambu: 'quay.io/biocontainers/bioconductor-bambu@sha256:90f2d83ffb099b90bcc5a1423b2c3d2455682d96e53412a0450bfb156c4409d6',
        diamond: 'quay.io/biocontainers/diamond@sha256:c3d56ca63d8061357ba0375d8d636519155b5601f6e93b807a827aa988f7e1d8',
        python_helper: 'docker.io/library/python@sha256:17b9724493d916f56565c131f389faff2597f46dec6ce09516f95125bc9f519f'
    ]
    use_containers = true
}

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        docker.enabled = false
        conda.enabled = false
    }
    test {
        process.executor = 'local'
        params.use_containers = false
        process {
            withName: '.*' {
                cpus = 1
                memory = '4.GB'
                time = '1.h'
            }
            withLabel: process_high {
                cpus = 1
                memory = '4.GB'
                time = '1.h'
            }
            withLabel: process_high_memory {
                cpus = 1
                memory = '4.GB'
                time = '1.h'
            }
        }
        params.mode = 'bam'
        params.manifest = "${projectDir}/test/data/manifest.tsv"
        params.reference_fasta = "${projectDir}/test/data/reference.fa"
        params.outdir = './results/test'
        params.model_backends = ['tama']
        params.backend_scopes = ['run']
    }
}

process {
    withLabel: process_light {
        errorStrategy = { task.exitStatus in [137, 143] && task.attempt <= params.resource_retry_max ? 'retry' : 'terminate' }
        maxRetries = params.resource_retry_max
        memory = { 2.GB * task.attempt }
        time = { 1.h * task.attempt }
    }
    withLabel: process_low {
        errorStrategy = { task.exitStatus in [137, 143] && task.attempt <= params.resource_retry_max ? 'retry' : 'terminate' }
        maxRetries = params.resource_retry_max
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withLabel: process_medium {
        errorStrategy = { task.exitStatus in [137, 143] && task.attempt <= params.resource_retry_max ? 'retry' : 'terminate' }
        maxRetries = params.resource_retry_max
        memory = { 16.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withLabel: process_high {
        errorStrategy = { task.exitStatus in [137, 143] && task.attempt <= params.resource_retry_max ? 'retry' : 'terminate' }
        maxRetries = params.resource_retry_max
        memory = { 60.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withLabel: process_high_memory {
        errorStrategy = { task.exitStatus in [137, 143] && task.attempt <= params.resource_retry_max ? 'retry' : 'terminate' }
        maxRetries = params.resource_retry_max
        memory = { 64.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withLabel: process_long {
        errorStrategy = { task.exitStatus in [137, 143] && task.attempt <= params.resource_retry_max ? 'retry' : 'terminate' }
        maxRetries = params.resource_retry_max
        memory = { 16.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: 'SPLIT_BAM_BY_CONTIG|TAMA_COLLAPSE|STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE|TMERGE_COLLAPSE|BAM_TO_ALIGNMENT_GTF|FLAIR_TRANSCRIPTOME' {
        maxForks = params.shard_max_concurrent ?: 4
    }
    withName: 'ACQUIRE_FASTQ|ACQUIRE_BAM' {
        maxForks = 10
    }
    withName: 'FLAIR_JUNCTIONS' {
        maxForks = 8
    }
    withName: 'TAMA_COLLAPSE' {
        cpus = 2
        memory = {
            def resource_class = shard_meta?.resource_class ?: 'small'
            def base = nextflow.util.MemoryUnit.of(resource_class == 'very_large' ? params.tama_memory_very_large :
                (resource_class == 'large' ? params.tama_memory_large : params.tama_memory_small))
            base + 64.GB * (task.attempt - 1)
        }
        time = { 96.h + 12.h * (task.attempt - 1) }
        errorStrategy = { task.attempt <= params.tama_max_retries ? 'retry' : 'terminate' }
        maxRetries = params.tama_max_retries
    }
    withName: 'STRINGTIE2_COLLAPSE|STRINGTIE3_COLLAPSE' {
        cpus = 4
        memory = {
            def resource_class = shard_meta?.resource_class ?: 'small'
            def base = nextflow.util.MemoryUnit.of(resource_class == 'very_large' ? '256.GB' :
                (resource_class == 'large' ? '128.GB' : '64.GB'))
            base * task.attempt
        }
        time = { 12.h * task.attempt }
    }
    withName: 'TMERGE_COLLAPSE' {
        cpus = 4
        memory = { 60.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: 'ISOQUANT_ANNOTATION_FREE|ISOQUANT_REFERENCE_GUIDED' {
        cpus = 8
        memory = { (params.isoquant_high_memory ? 256.GB : 128.GB) * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: 'FLAIR_JUNCTIONS' {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withName: 'FLAIR_TRANSCRIPTOME' {
        cpus = { params.flair_threads ?: 4 }
        memory = {
            def resource_class = shard_meta?.resource_class ?: 'small'
            def base = nextflow.util.MemoryUnit.of(resource_class == 'very_large' ? '256.GB' :
                (resource_class == 'large' ? '128.GB' : '64.GB'))
            base * task.attempt
        }
        time = { 12.h * task.attempt }
    }
    withName: 'FLAIR_COMBINE' {
        cpus = { params.flair_threads ?: 8 }
        memory = { 128.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: 'BAMBU_DISCOVERY' {
        cpus = 8
        memory = { 128.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: 'AUDIT_NATIVE_MODELS|AUDIT_BACKEND_SHARD_PLAN|VALIDATE_BACKEND_SHARD_PLAN' {
        memory = { 16.GB * task.attempt }
    }
}
