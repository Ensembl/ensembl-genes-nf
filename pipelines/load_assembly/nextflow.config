/*
========================================================================================
    LOAD_ASSEMBLY PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    assembly_accession = null  // GCA or GCF accession (e.g. GCA_000001405.29)
    assembly_name      = null  // assembly name (e.g. GRCh38.p14)
    outdir             = null
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'DOWNLOAD_ASSEMBLY' {
        memory     = { 2.GB * task.attempt }
        time       = '4.h'
        maxRetries = 2   // retry on network failure
    }
    withName: 'PREPARE_GENOME' {
        memory     = { 8.GB * task.attempt }
        time       = '2.h'
        maxRetries = 1
    }
    withName: 'PARSE_ASSEMBLY_REPORT' {
        memory = '1.GB'
        time   = '30.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
