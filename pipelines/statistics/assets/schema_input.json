{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/demultiplex/master/assets/schema_input.json",
    "title": "nf-core/demultiplex pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "taxon_id": {
                "type": "integer",
                "description": "NCBI taxon ID",
                "pattern": "^\\d+$",
                "errorMessage": "Taxon ID must be a number",
                "meta": ["taxon_id"]
            },
            "gca": {
                "type": "string",
                "description": "Genome assembly accession",
                "pattern": "^GCA_\\d{9}\\.\\d$",
                "errorMessage": "GCA must be in the format GCA_000000000.0",
                "meta": ["gca"]
            },
            "core": {
                    "type": "string",
                    "pattern": "^\\S+$",
                    "errorMessage": "Core(s) must be provided and db names cannot contain or have trailing spaces",
                    "meta": ["core"]
                },
            "species_id": {
                    "type": "integer",
                    "pattern": "^\\d+$",
                    "errorMessage": "Species id to identify the right assembly in the core",
                    "meta": "species_id"
                }
        }
    }
}
