/*
========================================================================================
    PROJECTION PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    source_fasta  = null   // softmasked source genome FASTA (split per chrom for LASTZ)
    query_fasta   = null   // target genome FASTA
    source_gff3   = null   // source gene annotation GFF3
    chain         = null   // pre-built chain file (skips LASTZ step)
    outdir        = null

    // Projection thresholds
    min_coverage  = 50.0   // minimum % of exon bases that must project
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'LASTZ' {
        cpus       = 4
        memory     = { 8.GB * task.attempt }
        time       = '8.h'
        maxRetries = 1
    }
    withName: 'PROJECT_TRANSCRIPTS' {
        memory     = { 4.GB * task.attempt }
        time       = '2.h'
        maxRetries = 1
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
