/*
========================================================================================
    SHORT_NCRNA PIPELINE CONFIGURATION
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    genome_fasta           = null   // UNMASKED genome FASTA
    rfam_cm                = null   // Rfam.cm covariance model file
    mirna_fasta            = null   // optional: miRBase all_mirnas.fa
    mirna_blast_db         = null   // optional: BLAST DB directory of genome
    outdir                 = null

    // Genome chunking
    chunk_size             = 1000   // sequences per chunk (splitFasta 'by' param)

    // cmsearch filtering
    cmsearch_max_evalue    = 0.01
    cmsearch_min_score     = 0      // 0 = rely on --cut_ga Rfam gathering thresholds

    // miRNA BLAST filtering
    mirna_blast_min_pid    = 80
    mirna_blast_max_evalue = 0.01
}

process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'SEARCH_NCRNA:CMSEARCH' {
        ext.args   = '--rfam --nohmmonly --cut_ga'
        cpus       = 4
        memory     = { 4.GB * task.attempt }
        time       = '4.h'
        maxRetries = 1
    }
    withName: 'SEARCH_NCRNA:BLASTN_MIRNA' {
        cpus       = 3
        memory     = { 2.GB * task.attempt }
        time       = '2.h'
    }
    withName: 'SEARCH_NCRNA:FILTER_NCRNA' {
        memory = '1.GB'
        time   = '30.m'
    }
}

profiles {
    slurm {
        process { executor = 'slurm' }
    }
    local {
        process { executor = 'local'; maxForks = 4 }
        singularity { cacheDir = './singularity_cache' }
    }
    conda {
        conda { enabled = true; useMicromamba = true; cacheDir = './conda_cache' }
        singularity.enabled = false
    }
    docker {
        docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
        singularity.enabled = false
    }
}
