/*
========================================================================================
    LONG_READ PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Pipeline-specific parameters
params {
    // Required — set on the command line or via -params-file
    sample_sheet   = null
    genome_fasta   = null
    genome_index   = null   // optional; built from genome_fasta if absent
    protein_db     = null
    outdir         = null

    // Algorithm parameters
    minimap2_preset      = 'splice'
    collapse_min_overlap = 0.8
    blast_evalue         = 1e-5
    max_intron_size      = 200000
    skip_download        = false
}

// Process-specific configuration
process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'MINIMAP2_INDEX' {
        memory     = { 20.GB * task.attempt }
        time       = '4.h'
    }
    withName: 'ALIGN:MINIMAP2_ALIGN' {
        ext.args   = { "-ax ${meta.minimap2_preset ?: params.minimap2_preset} --cs -L" }
        memory     = { 15.GB * task.attempt }
        time       = '12.h'
        maxRetries = 2
    }
    withName: 'ALIGN:SAMTOOLS_SORT' {
        ext.args   = '-m 2G'
    }
    withName: 'COLLAPSE:COLLAPSE_TRANSCRIPTS' {
        memory     = { 5.GB * task.attempt }
        maxRetries = 2
        time       = '6.h'
    }
    withName: 'CLASSIFY:BLAST_BLASTP' {
        ext.args   = { "-evalue ${params.blast_evalue} -max_target_seqs 1 -seg no -outfmt '6 qseqid sseqid pident length evalue bitscore'" }
        cpus       = 4
        memory     = { 3.GB * task.attempt }
        maxRetries = 2
    }
    withName: 'CLASSIFY:CLASSIFY_TRANSCRIPTS' {
        memory = '2.GB'
    }
}

// Execution profiles
profiles {
    // Default: SLURM with Singularity (for HPC cluster execution)
    slurm {
        process {
            executor = 'slurm'
        }
    }

    // Local execution (for testing/development)
    local {
        process {
            executor = 'local'
            maxForks = 2
        }
        singularity {
            cacheDir = './singularity_cache'
        }
    }

    // Conda-based execution (alternative to containers)
    conda {
        conda {
            enabled       = true
            useMicromamba = true
            cacheDir      = './conda_cache'
        }
        singularity.enabled = false
    }

    // Docker execution (for non-HPC environments)
    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        singularity.enabled = false
    }
}
