includeConfig '../../nextflow.config'

nextflow.enable.strict = true

plugins {
    id 'nf-schema@2.2.0'
}

params {
    build_manifest = null
    outdir = './results'
    uniprot_api = 'https://rest.uniprot.org/uniprotkb/search'
    page_size = 500
    use_containers = true
    tool_containers = [
        python_helper: 'docker.io/library/python@sha256:17b9724493d916f56565c131f389faff2597f46dec6ce09516f95125bc9f519f',
        diamond: 'quay.io/biocontainers/diamond@sha256:c3d56ca63d8061357ba0375d8d636519155b5601f6e93b807a827aa988f7e1d8'
    ]
}

process {
    withName: FETCH_UNIPROT_FASTA {
        label = 'process_medium'
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxForks = 2
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: BUILD_DIAMOND_DB {
        label = 'process_high'
        cpus = 8
        memory = { 60.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
}

profiles {
    test {
        process.executor = 'local'
        params.build_manifest = "${projectDir}/assets/test_build_manifest.tsv"
        params.outdir = './results/test'
        params.use_containers = false

        process {
            withName: FETCH_UNIPROT_FASTA {
                cpus = 1
                memory = '2.GB'
                time = '1.h'
            }

            withName: BUILD_DIAMOND_DB {
                cpus = 1
                memory = '2.GB'
                time = '1.h'
            }
        }
    }

    slurm {
        process.executor = 'slurm'
    }

    local {
        process.executor = 'local'
        process.maxForks = 2
    }
}
