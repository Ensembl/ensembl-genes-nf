/*
========================================================================================
    REPEAT_MASKING PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Pipeline-specific parameters
params {
    genome_fasta         = null
    outdir               = null
    repbase_library      = null
    custom_library       = null
    species              = 'mammals'
    skip_repeatmodeler   = true    // default: skip; set false to run RepeatModeler
    skip_red             = false
    skip_trf             = false
    skip_dust            = false
    repeatmasker_threads = 4
    chunk_size           = 10000000  // 10 Mb chunks
}

// Process-specific configuration
process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'BUILD_LIBRARY:REPEATMODELER_REPEATMODELER' {
        cpus       = 16
        memory     = { 32.GB * task.attempt }
        time       = '5.d'
    }
    withName: 'MASK_REPEATS:REPEATMASKER_REPEATMASKER' {
        cpus       = { params.repeatmasker_threads }
        memory     = { 6.GB * task.attempt }
        time       = '12.h'
        maxRetries = 2
    }
    withName: 'MASK_REPEATS:RED' {
        cpus   = 8
        memory = { 50.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'MASK_REPEATS:TRF' {
        memory     = { 8.GB * task.attempt }
        time       = '4.h'
        maxRetries = 2
    }
    withName: 'MASK_REPEATS:DUSTMASKER' {
        memory = '3.GB'
        time   = '2.h'
    }
    withName: 'MASK_REPEATS:MERGE_REPEATS' {
        memory = '8.GB'
        time   = '2.h'
    }
    withName: 'MASK_REPEATS:BEDTOOLS_MASKFASTA' {
        memory = { 8.GB * task.attempt }
        time   = '2.h'
    }
}

// Execution profiles
profiles {
    // Default: SLURM with Singularity (for HPC cluster execution)
    slurm {
        process {
            executor = 'slurm'
        }
    }

    // Local execution (for testing/development)
    local {
        process {
            executor = 'local'
            maxForks = 2
        }
        singularity {
            cacheDir = './singularity_cache'
        }
    }

    // Conda-based execution (alternative to containers)
    conda {
        conda {
            enabled       = true
            useMicromamba = true
            cacheDir      = './conda_cache'
        }
        singularity.enabled = false
    }

    // Docker execution (for non-HPC environments)
    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        singularity.enabled = false
    }
}
