plugins {
    id 'nf-schema@2.2.0'
}

params {
    manifest = null
    outdir = './long-read-stringtie3-results'
    use_containers = true
    max_index_jobs = 2
    max_alignment_jobs = 2
    max_stringtie_assembly_jobs = 2
    max_stringtie_merge_jobs = 1
    max_stringtie_quantification_jobs = 2
    executor_queue_size = 8
    tool_containers = [
        alignment: 'quay.io/biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4@sha256:9352893c7f30ec6a3d6e5591d14a4034260a9489537d6577a0a23ae8ee8fd259',
        stringtie3: 'quay.io/biocontainers/stringtie@sha256:1e2d08591607f70ee10b830a5fd17eaa3c1c34d25ca28cb224a73658053a1f31'
    ]
}

docker.enabled = true
executor.queueSize = params.executor_queue_size

process {
    withLabel: index {
        cpus = 4
        memory = 32.GB
        time = 8.h
        maxForks = params.max_index_jobs
    }
    withLabel: alignment {
        cpus = 8
        memory = 32.GB
        time = 24.h
        maxForks = params.max_alignment_jobs
    }
    withLabel: stringtie_assembly {
        cpus = 4
        memory = 32.GB
        time = 24.h
        maxForks = params.max_stringtie_assembly_jobs
    }
    withLabel: stringtie_merge {
        cpus = 4
        memory = 16.GB
        time = 12.h
        maxForks = params.max_stringtie_merge_jobs
    }
    withLabel: stringtie_quantification {
        cpus = 4
        memory = 16.GB
        time = 12.h
        maxForks = params.max_stringtie_quantification_jobs
    }
}

profiles {
    docker_runtime {
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = true
    }
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    test {
        params.use_containers = false
        process.executor = 'local'
        process.resourceLimits = [cpus: 4, memory: 8.GB]
    }
}
