includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
    id 'nf-boost@0.8.0'
}

params {
    manifest = null
    run_mode = 'batch'
    defer_merge = 'false'
    outdir = './long-read-stringtie3-results'
    tracedir = "${params.outdir}/pipeline_info"
    // Defaults to per_assembly within outdir. Set this to a stable shared
    // directory to reuse references across separate result directories.
    reference_cache_dir = null
}

docker.enabled = true
// maxForks is per process; queueSize is the executor-wide submission ceiling.
// Keep enough slots for 20 alignments plus downstream stages to make progress.
executor.queueSize = 100

boost {
    cleanup = false
    cleanupInterval = '180s'
    // Preserve failed attempts so ignored failures remain diagnosable.
    cleanupFailedTasks = false
}

process {
    // Apply one consistent failure policy to every task in this pipeline.
    // Resource-class selectors below override the default 4 GB / 2 hour
    // allocation and increase their own resources on this retry.
    maxRetries = 1
    maxErrors = -1
    errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    memory = { 4.GB * task.attempt }
    time = { 2.h * task.attempt }

    withLabel: genome_download {
        cpus = { task.attempt == 1 ? 1 : 2 }
        memory = { task.attempt == 1 ? 4.GB : 8.GB }
        time = { task.attempt == 1 ? 24.h : 36.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: fastq_download {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 8.GB : 16.GB }
        time = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: index {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 64.GB : (task.attempt == 2 ? 128.GB : 192.GB) }
        time = { 8.h * task.attempt }
        maxForks = 2
        maxRetries = 2
        maxErrors = -1
    }
    withLabel: fasta_index {
        cpus = { task.attempt == 1 ? 1 : 2 }
        memory = { task.attempt == 1 ? 4.GB : 8.GB }
        time = { task.attempt == 1 ? 2.h : 4.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: alignment {
        cpus = { task.attempt == 1 ? 8 : 12 }
        memory = { task.attempt == 1 ? 32.GB : 64.GB }
        time = { task.attempt == 1 ? 24.h : 36.h }
        maxForks = 20
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: bam_index {
        cpus = { task.attempt == 1 ? 1 : 2 }
        memory = { task.attempt == 1 ? 4.GB : 8.GB }
        time = { task.attempt == 1 ? 4.h : 8.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: alignment_qc {
        cpus = { task.attempt == 1 ? 2 : 4 }
        memory = { task.attempt == 1 ? 8.GB : 16.GB }
        time = { task.attempt == 1 ? 4.h : 8.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: stringtie_assembly {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 32.GB : 64.GB }
        time = { task.attempt == 1 ? 24.h : 36.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: stringtie_merge {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 16.GB : 32.GB }
        time = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 1
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: stringtie_quantification {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 16.GB : 32.GB }
        time = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
    }
}

profiles {
    low_storage {
        boost.cleanup = true
    }
    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        docker.enabled = false
        conda.enabled = false
    }
    docker_runtime {
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = true
    }
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    test {
        process.executor = 'local'
        process.resourceLimits = [cpus: 4, memory: 8.GB]
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = false
    }
}
