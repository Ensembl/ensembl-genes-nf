includeConfig '../../nextflow.config'

plugins {
    id 'nf-schema@2.2.0'
}

params {
    manifest = null
    outdir = './long-read-stringtie3-results'
    tracedir = "${params.outdir}/pipeline_info"
}

docker.enabled = true
executor.queueSize = 8

process {
    withLabel: genome_download {
        cpus = { task.attempt == 1 ? 1 : 2 }
        memory = { task.attempt == 1 ? 4.GB : 8.GB }
        time = { task.attempt == 1 ? 24.h : 36.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: fastq_download {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 8.GB : 16.GB }
        time = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: index {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 32.GB : 64.GB }
        time = { task.attempt == 1 ? 8.h : 16.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: fasta_index {
        cpus = { task.attempt == 1 ? 1 : 2 }
        memory = { task.attempt == 1 ? 4.GB : 8.GB }
        time = { task.attempt == 1 ? 2.h : 4.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: alignment {
        cpus = { task.attempt == 1 ? 8 : 12 }
        memory = { task.attempt == 1 ? 32.GB : 64.GB }
        time = { task.attempt == 1 ? 24.h : 36.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: bam_index {
        cpus = { task.attempt == 1 ? 1 : 2 }
        memory = { task.attempt == 1 ? 4.GB : 8.GB }
        time = { task.attempt == 1 ? 4.h : 8.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: alignment_qc {
        cpus = { task.attempt == 1 ? 2 : 4 }
        memory = { task.attempt == 1 ? 8.GB : 16.GB }
        time = { task.attempt == 1 ? 4.h : 8.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: stringtie_assembly {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 32.GB : 64.GB }
        time = { task.attempt == 1 ? 24.h : 36.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: stringtie_merge {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 16.GB : 32.GB }
        time = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 1
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
    withLabel: stringtie_quantification {
        cpus = { task.attempt == 1 ? 4 : 8 }
        memory = { task.attempt == 1 ? 16.GB : 32.GB }
        time = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 2
        maxRetries = 1
        maxErrors = -1
        errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        docker.enabled = false
        conda.enabled = false
    }
    docker_runtime {
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = true
    }
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    test {
        process.executor = 'local'
        process.resourceLimits = [cpus: 4, memory: 8.GB]
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = false
    }
}
