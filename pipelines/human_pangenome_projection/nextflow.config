/*
========================================================================================
    HUMAN PANGENOME PROJECTION CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// nf-schema plugin for parameter validation
plugins {
    id 'nf-schema@2.2.0'
}

// Pipeline-specific parameters — all must also appear in nextflow_schema.json
params {
    // Input / output
    sample_sheet = null                       // required: CSV with columns target_id,target_fasta
    outdir       = './results'

    // Shared reference
    ref_fasta = null                          // required: reference genome FASTA
    ref_gff   = null                          // required: reference annotation GFF3

    // Projection scope
    chromosomes = null                        // optional: comma-separated subset, e.g. 'chr20'

    // Whole-genome aligner (swappable front-end)
    minimap2_preset = 'asm5'                  // asm5 (<0.5% div) | asm10 | asm20

    // Tool container (built from containers/Dockerfile; push to a registry then set this)
    hpp_container = 'ghcr.io/ensembl/hpp:0.1.0'

    // Optional extra flags forwarded to the projection stages (rescue caps, thresholds, …)
    hpp_extra_args = ''
}

// Turn the chromosome subset param into repeated -c flags for build-synteny.
def chromArgs = params.chromosomes
    ? params.chromosomes.toString().split(/[,\s]+/).findAll { it }.collect { "-c ${it}" }.join(' ')
    : ''

// Process-specific configuration
process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    withName: 'PANGENOME_PROJECTION:MINIMAP2_WGA' {
        ext.args = "-cx ${params.minimap2_preset} --cs=long"
    }

    withName: 'PANGENOME_PROJECTION:BUILD_SYNTENY' {
        // Chromosome scope + any extra projection flags are set once here and
        // serialized into the run config, so downstream stages inherit them.
        ext.args = "${chromArgs} ${params.hpp_extra_args}".trim()
    }
}

// Execution profiles — override base Singularity settings where needed
profiles {
    slurm {
        process {
            executor = 'slurm'
        }
        singularity {
            enabled    = true
            autoMounts = true
        }
    }

    local {
        process {
            executor = 'local'
            maxForks = 2
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = './singularity_cache'
        }
    }

    // No-container local execution — for `-stub` scaffold validation and local
    // functional-parity runs off-cluster. Fails loudly (no 'ignore') so problems surface.
    stub {
        process {
            executor      = 'local'
            maxForks      = 2
            errorStrategy = 'terminate'
            // Clamp cluster-sized resource labels to a laptop.
            resourceLimits = [ cpus: 4, memory: '8.GB', time: '1.h' ]
        }
        singularity.enabled = false
        docker.enabled      = false
    }
}
