# Placeholder Dockerfile for ORF-RATER (Wave 2)
FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-pip bedtools samtools && \
    pip3 install plastid pybedtools && \
    rm -rf /var/lib/apt/lists/*
