# Placeholder Dockerfile for PRICE (GeDI)
FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates openjdk-11-jre-headless python3 python3-pip curl unzip && \
    rm -rf /var/lib/apt/lists/*
