{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Example Pipeline Parameters",
    "description": "Parameter schema for the example pipeline",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Path to input file"
      },
      "outdir": {
        "type": "string",
        "default": "./results",
        "description": "Output directory"
      }
    },
    "required": ["input"]
  }