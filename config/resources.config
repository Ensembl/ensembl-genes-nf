// Resource allocation definitions for process labels
// This file defines standard resource classes that can be used across all pipelines


// These are AI generated suggestions but we should populate with the ones we have in eHive

process {
    // Light processes - QC, small file operations, quick scripts
    withLabel: process_light {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '1.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // Low resource processes - most standard bioinformatics tools
    withLabel: process_low {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '4.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // Medium resource processes - alignment, assembly steps
    withLabel: process_medium {
        cpus   = 4
        time   = '8.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
        memory = { 16.GB * task.attempt }
    }

    // Single-threaded callers with a standard memory footprint
    withLabel: process_single_medium {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = '8.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // High resource processes - intensive computations
    withLabel: process_high {
        cpus   = 8
        memory = { 60.GB * task.attempt }
        time   = '12.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    withLabel: process_ultra_high {
        cpus   = 8
        memory = { 120.GB * task.attempt }
        time   = '24.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // High memory processes - genome loading, large data structures
    withLabel: process_high_memory {
        cpus   = 2
        memory = { 64.GB * task.attempt }
        time   = '8.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // Single-threaded callers that need a large genome-sized working set
    withLabel: process_single_high_memory {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = '24.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // Long running processes - large genome processing
    withLabel: process_long {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '24.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    // Single threaded processes that need time
    withLabel: process_single_long {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '12.h'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }
}

// Profile-specific resource overrides
profiles {
    // Local profile - minimal resources for stub testing
    local {
        process {
            executor = 'local'
            maxForks = 2

            withLabel: process_light {
                cpus   = 1
                memory = '512.MB'
                time   = '10.m'
            }

            withLabel: process_low {
                cpus   = 1
                memory = '1.GB'
                time   = '10.m'
            }

            withLabel: process_medium {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_single_medium {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_high {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_high_memory {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_single_high_memory {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_ultra_high {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_long {
                cpus   = 1
                memory = '2.GB'
                time   = '10.m'
            }

            withLabel: process_single_long {
                cpus   = 1
                memory = '1.GB'
                time   = '10.m'
            }
        }

        singularity {
            enabled = false
        }
    }
}
