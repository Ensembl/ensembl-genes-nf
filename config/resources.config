// Resource allocation definitions for process labels
// Each label defines BASE resources; errorStrategy 'retry' multiplies memory by task.attempt.
// Guard rails: params.max_memory / params.max_cpus / params.max_time cap every job.

process {

    // ── Light processes ────────────────────────────────────────────────────
    // QC, small file operations, quick scripts
    withLabel: process_light {
        cpus   = 1
        memory = { check_max(2.GB   * task.attempt, 'memory') }
        time   = { check_max(1.h    * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // ── Low resource processes ─────────────────────────────────────────────
    // Standard bioinformatics tools, downloads, indexing
    withLabel: process_low {
        cpus   = 2
        memory = { check_max(8.GB   * task.attempt, 'memory') }
        time   = { check_max(4.h    * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // ── Medium resource processes ──────────────────────────────────────────
    // Alignment, assembly steps, moderate compute
    withLabel: process_medium {
        cpus   = 4
        memory = { check_max(16.GB  * task.attempt, 'memory') }
        time   = { check_max(8.h    * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // ── High resource processes ────────────────────────────────────────────
    // STAR alignment, RepeatMasker chunks, intensive compute
    withLabel: process_high {
        cpus   = 8
        memory = { check_max(60.GB  * task.attempt, 'memory') }
        time   = { check_max(24.h   * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // ── High memory processes ──────────────────────────────────────────────
    // Genome loading, STAR index for large genomes, large data structures
    withLabel: process_high_memory {
        cpus   = 2
        memory = { check_max(128.GB * task.attempt, 'memory') }
        time   = { check_max(8.h    * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // ── Long running processes ─────────────────────────────────────────────
    // Large genome processing with moderate resources
    withLabel: process_long {
        cpus   = 4
        memory = { check_max(16.GB  * task.attempt, 'memory') }
        time   = { check_max(48.h   * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // ── Single-threaded long-running processes ─────────────────────────────
    withLabel: process_single_long {
        cpus   = 1
        memory = { check_max(8.GB   * task.attempt, 'memory') }
        time   = { check_max(12.h   * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // ── RepeatModeler — de novo repeat library construction ────────────────
    // Needs many CPUs and days for a mammal genome (2.5 GB ~= 5–7 days at 32 CPU).
    // RepeatModeler cannot use more than one node; fix ntasks=1 in SLURM.
    withLabel: process_repeatmodeler {
        cpus   = 32
        memory = { check_max(64.GB  * task.attempt, 'memory') }
        time   = { check_max(7.d    * task.attempt, 'time'  ) }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // ── Master pipeline launcher jobs ──────────────────────────────────────
    // Each runs `nextflow run ./pipelines/X` and waits for child pipeline.
    // Minimal CPU/RAM but must survive the full duration of the sub-pipeline.
    withLabel: process_launcher {
        cpus   = 1
        memory = '2.GB'
        time   = '7d'
        // Launcher jobs must not be retried on OOM — if they die the child
        // pipeline's work is preserved by -resume.
        errorStrategy = 'finish'
    }
}
